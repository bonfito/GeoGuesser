Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`Private`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<Pacchetto_corretto.wl\>\"", "]"}], ";"}], "\n", 
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cliccato", "=", "False"}], "}"}], ",", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<Avvia Gioco\>\"", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", "cliccato"}], ",", 
       RowBox[{
        RowBox[{"CellPrint", "[", 
         RowBox[{"ExpressionCell", "[", 
          RowBox[{
           RowBox[{"GeneraInterfaccia", "[", "]"}], ",", "\"\<Output\>\""}], 
          "]"}], "]"}], ";", 
        RowBox[{"cliccato", "=", "True"}], ";"}]}], "]"}], ",", 
     RowBox[{"Enabled", "->", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"!", "cliccato"}], "]"}]}], ",", 
     RowBox[{"Method", "->", "\"\<Queued\>\""}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"150", ",", "50"}], "}"}]}], ",", 
     RowBox[{"Background", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.1`", ",", "0.4`", ",", "0.9`"}], "]"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"{", 
       RowBox[{"White", ",", "Bold", ",", 
        RowBox[{"FontSize", "->", "16"}]}], "}"}]}]}], "]"}]}], 
  "]"}]}], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9858392419526634`*^9, 3.985839337558592*^9}},
 CellLabel->"In[33]:=",ExpressionUUID->"30ba4fdd-dc94-4bd1-9cef-fe2303d387b6"],

Cell[BoxData[
 DynamicModuleBox[{$CellContext`cliccato$$ = False}, 
  ButtonBox["\<\"Avvia Gioco\"\>",
   Appearance->Automatic,
   Background->RGBColor[0.1, 0.4, 0.9],
   BaseStyle->{
     GrayLevel[1], Bold, FontSize -> 16},
   ButtonFunction:>If[
     Not[$CellContext`cliccato$$], CellPrint[
       ExpressionCell[
        HangmanGame`GeneraInterfaccia[], "Output"]]; $CellContext`cliccato$$ = 
