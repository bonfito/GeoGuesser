 CellLabel->"Out[37]=",ExpressionUUID->"74494569-4f84-46c4-9f33-f1c7e5daceb5"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Indice",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["\n",
  FontSize->20,
  FontWeight->"Bold"],
 StyleBox["Introduzione\n",
  FontSize->20,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox["I. Regole del gioco\nII. Guida all'uso dell'Interfaccia\
\[LineSeparator]\tFase di selezione\n\tFase di gioco\nIII. Livello Bonus e \
Interfaccia\nIV. Approfondimenti\n\tStoria\n\tStrategia\n\tFunzionamento del \
Seed\n\tSchema delle dipendenze funzionali\nV. Bibliografia e Sitografia\nVI. \
Commenti e lavoro futuro",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 "\n"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.9858360014789486`*^9, 3.9858360306143284`*^9}, {
   3.9858360732825184`*^9, 3.985836145124634*^9}, {3.9858361954915047`*^9, 
   3.9858361969220734`*^9}, {3.9858362329447994`*^9, 
   3.9858362673060646`*^9}, {3.985836327335438*^9, 3.985836353543562*^9}, {
   3.9858363906426277`*^9, 3.985836483617651*^9}, {3.9858374962166767`*^9, 
   3.98583750173946*^9}, {3.9858375866057167`*^9, 3.985837630997324*^9}, {
   3.985837684023142*^9, 3.9858376858858986`*^9}, {3.9858377358055496`*^9, 
   3.985837739437933*^9}, {3.9858378073290215`*^9, 3.9858378224481792`*^9}, {
   3.985837871715273*^9, 3.9858379528118877`*^9}, {3.9858386000979633`*^9, 
   3.9858386326541595`*^9}, 3.9873393814061832`*^9, {3.98740915493186*^9, 
   3.98740919761302*^9}, {3.987600279716486*^9, 3.98760033928755*^9}, {
   3.9876887668521967`*^9, 3.9876887772581453`*^9}, {3.9876893312188873`*^9, 
   3.987689339662589*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"a2cf4ed4-8e98-2244-a2be-22e64bc08852"],

Cell[TextData[{
 StyleBox["Introduzione\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Benvenuto in Geographic Hangman! \nQuesto progetto \[EGrave] una \
rivisitazione interattiva e didattica del classico gioco dell'impiccato.\n\
L'obiettivo dell'applicativo \[EGrave] unire il ragionamento logico e la \
conoscenza geografica. Il gioco \[EGrave] progettato per essere intuitivo e \
non richiede alcuna competenza informatica pregressa: tutto \[EGrave] gestito \
da una comoda interfaccia grafica.\[LineSeparator]Mettiti alla prova, \
indovina le nazioni nascoste e scala le classifiche!",
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}, {3.9874096802827625`*^9, 3.987409693324892*^9}, {
  3.987423139293293*^9, 3.9874231510466156`*^9}, {3.9876009833462334`*^9, 
  3.9876010020359287`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"c6da6e88-2037-be42-abe5-6f1cb2d9dae3"],

Cell[TextData[{
 StyleBox["I. Regole del gioco\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Il computer sceglie il nome di una Nazione in base al seed \
inserito [",
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox[ButtonBox["3",
  BaseStyle->"Hyperlink",
  ButtonData->"Bibliografia"],
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["]. Il tuo compito \[EGrave] indovinare la parola lettera per \
lettera prima di commettere 6 errori (che porteranno al completamento del \
disegno dell'impiccato).\n\nLa difficolt\[AGrave] (Facile, Media, Difficile) \
influenza tre fattori:\n\t 1. Lunghezza della parola: pi\[UGrave] \[EGrave] \
alta la difficolt\[AGrave], pi\[UGrave] i nomi delle Nazioni saranno lunghi.\n\
\t 2. Punteggio: riceverai pi\[UGrave] punti per ogni lettera corretta se \
giochi a difficolt\[AGrave] elevata.\n\t 3. Penalit\[AGrave]: richiedere un \
suggerimento coster\[AGrave] pi\[UGrave] punti ai livelli di difficolt\
\[AGrave] maggiori.",
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}, {3.9873512930195704`*^9, 3.987351294208749*^9}, {
  3.987600807091959*^9, 3.987600830924261*^9}, {3.987600861653717*^9, 
  3.987600962174679*^9}, {3.987602511880476*^9, 3.9876025139711304`*^9}, {
  3.9876025868946323`*^9, 3.9876025868946323`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"c1d52f11-e0af-304c-b931-3923f58b8f58"],

Cell[TextData[{
 StyleBox["II. Guida all'uso dell'Interfaccia\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["L'interfaccia si divide in due fasi principali. Ecco come \
utilizzare tutte le funzionalit\[AGrave] a tua disposizione:\[LineSeparator]",
  
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["\n",
  FontSize->17],
 StyleBox["1. Fase di Selezione (Genera Esercizio e Seed)\n",
  FontSize->25,
  FontColor->RGBColor[0.65, 0.4, 0]],
 StyleBox["\[Bullet] Seleziona la difficolt\[AGrave]: usa i bottoni per \
scegliere il livello (Facile, Media, Difficile).\n\t Facile: parole da 1 a 5 \
lettere\[LineSeparator]\t Media: parole da 6 a 8 lettere\[LineSeparator]\t \
Difficile: parole da 9 a 15 lettere\n\[Bullet] Seed (Opzionale): puoi \
inserire un numero intero nel campo di testo. Inserendo lo stesso numero in \
partite future,  il computer generer\[AGrave] esattamente la stessa parola. \
\[CapitalEGrave] utile per sfidare un amico ad armi pari!\[LineSeparator]Nel \
caso in cui non venga inserito alcun valore, il seed verr\[AGrave] generato \
casualmente dal computer, in modo da ritornare una nazione diversa ad ogni \
partita.\[LineSeparator]\n\[Bullet] Clicca su \[OpenCurlyDoubleQuote]Avvia \
Gioco\[CloseCurlyDoubleQuote] per generare l'esercizio.\n",
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["\n 2. Fase di Gioco (Verifica Risultato)\n",
  FontSize->25,
  FontColor->RGBColor[0.65, 0.4, 0]],
 StyleBox["\[Bullet] Tastiera a schermo: Clicca sulle lettere per fare un \
tentativo. Se la lettera \[EGrave] corretta (Verifica Risultato positiva) \
diventer\[AGrave] verde e guadagnerai punti a seconda della \
difficolt\[AGrave] selezionata:\[LineSeparator]\tFacile: +10 punti\
\[LineSeparator]\tMedia: +20 punti\[LineSeparator]\tDifficile: +30 punti\
\[LineSeparator]Se \[EGrave] sbagliata, diventer\[AGrave] rossa, non verranno \
sottratti punti ma verr\[AGrave] aggiunto un pezzo al patibolo.\n\[Bullet] \
Suggerimento: se sei bloccato, clicca su \"Suggerimento\". Il computer sveler\
\[AGrave] una lettera mancante, ma ti verranno sottratti dal punteggio dei \
punti in base alla difficolt\[AGrave] selezionata:\[LineSeparator]\tFacile: \
-5 punti\[LineSeparator]\tMedia: -10 punti\[LineSeparator]\tDifficile: -15 \
punti\n\[Bullet] Mostra Soluzione: se vuoi arrenderti, clicca su questo \
bottone. Un pop-up ti riveler\[AGrave] la parola nascosta e la partita \
terminer\[AGrave].\n\[Bullet] Pulisci Campi: questo tasto azzera i tuoi \
tentativi, gli errori e il punteggio per la nazione corrente, permettendoti \
di ricominciare da capo la stessa parola (utile dopo aver visto la \
soluzione).",
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}, {3.987351461665354*^9, 3.987351461924592*^9}, {
  3.987600663965748*^9, 3.98760079184289*^9}, {3.9876869905668917`*^9, 
  3.987687190248562*^9}, {3.9876872440159492`*^9, 3.987687263933475*^9}, {
  3.987688043909877*^9, 3.987688067454506*^9}, {3.987688843857503*^9, 
  3.987688902117683*^9}, {3.987689343116588*^9, 3.9876893435372887`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"8b9859a0-bc1f-4913-8f0f-331c59ce4f3b"],

Cell[TextData[{
 StyleBox["III. Livello Bonus e Interfaccia\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Se riesci a indovinare la Nazione senza farti impiccare, avrai \
accesso a una Domanda Bonus. Ti verranno proposti 4 bottoni a scelta multipla \
per indovinare la Capitale di quella specifica Nazione. \nSe indovini, \
guadagnerai ben ",
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["50 punti",
  FontSize->17,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[" extra!\nAl termine della partita (vittoria o sconfitta), potrai \
salvare il tuo nome e confrontare il tuo punteggio nella Classifica dei \
migliori 50 giocatori.\[LineSeparator]Nel caso in cui lo stesso utente \
registri un punteggio maggiore in una seconda partita, verr\[AGrave] salvato \
in classifica soltanto il punteggio pi\[UGrave] alto.",
  FontSize->17,
  FontColor->GrayLevel[0.1]],
 StyleBox["\n",
  FontSize->17,
  FontColor->GrayLevel[0.88]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}, {3.9876006546107903`*^9, 3.987600655544779*^9}, {
  3.9876872945831203`*^9, 3.9876873510467873`*^9}},
 Background->GrayLevel[
  1],ExpressionUUID->"b8a5fdc3-dfff-48f4-accd-b0d2c30c0c9d"],

Cell[TextData[{
 StyleBox["IV.  Approfondimenti\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["1. Storia",
  FontSize->25,
  FontColor->RGBColor[0.65, 0.4, 0]],
 StyleBox["\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Tony Augarde sostiene che il gioco pare essere stato inventato \
nell\[CloseCurlyQuote]epoca vittoriana (vedi \[OpenCurlyDoubleQuote]The \
Oxford Guide to Word Games\[CloseCurlyDoubleQuote], Oxford University Press). \
Il gioco viene citato anche nel libro \[OpenCurlyDoubleQuote]Traditional \
Games\[CloseCurlyDoubleQuote] di Alice Bertha Gomme del 1894, col nome \
\[OpenCurlyDoubleQuote]Uccelli, belve e pesci.\[CloseCurlyDoubleQuote] Le \
regole sono quasi uguali, eccetto che il giocatore che sceglie la parola deve \
scriverne subito la prima e l\[CloseCurlyQuote]ultima lettera [",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox[ButtonBox["4",
  BaseStyle->"Hyperlink",
  ButtonData->"Bibliografia"],
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["].\n\n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["2",
  FontSize->24,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox[". Strategia\n",
  FontSize->25,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox["L\[CloseCurlyQuote]unica strategia generale per questo gioco pu\
\[OGrave] basarsi su una tabella della frequenza delle varie lettere in \
italiano (o nella lingua in cui si gioca); tuttavia, questa idea si presta \
altrettanto bene a essere usata con scopi opposti dal giocatore che sceglie \
la parola (es., una parola come \[OpenCurlyDoubleQuote]hobby\
\[CloseCurlyDoubleQuote] potrebbe essere molto difficile da immaginare \
proprio perch\[EAcute] contiene poche lettere, e almeno due molto poco \
frequenti).\nUna buona tattica pu\[OGrave] essere psicologica, ossia \
conoscere il proprio avversario e i suoi campi d\[CloseCurlyQuote]interesse [",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox[ButtonBox["4",
  BaseStyle->"Hyperlink",
  ButtonData->"Bibliografia"],
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["].\n\n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["3",
  FontSize->24,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox[". Funzionamento del Seed\n",
  FontSize->25,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox["\nDurante la fase di selezione del seed non \[EGrave] possibile \
inserire: numeri negativi, caratteri speciali, lettere \
dell\[CloseCurlyQuote]alfabeto o qualsiasi altro carattere diverso da un \
numero naturale positivo.\[LineSeparator]Il valore del Seed fornito verr\
\[AGrave] utilizzato da SeedRandom[seed] per inizializzare il generatore di \
numeri casuali di Mathematica con un valore fisso. Qualsiasi intero positiv\
\[OGrave] andr\[AGrave] bene, anche se molto grande.\[LineSeparator]Il valore \
viene utilizzato per generare una nazione casuale dalla wordlist, e una volta \
assegnata, la nazione sar\[AGrave] sempre la stessa per quel determinato \
valore, a patto che si rimanga nella stessa difficolt\[AGrave]. Con seed \
inserito, RandomChoice restituisce sempre la stessa parola. Seed specificato \
-> parola deterministica. Questo vale su qualsiasi PC e Sistema Operativo.\n\n\
Nel caso in cui non venga inserito alcun seed, SeedRandom[Automatic] usa il \
timestamp corrente come sorgente di casualit\[AGrave], in modo da ritornare \
una Nazione diversa ad ogni esecuzione.\nIl seed \[EGrave] legato alla \
combinazione seed + difficolt\[AGrave]. Lo stesso seed con difficolt\[AGrave] \
diversa ritorner\[AGrave] parole diverse perch\[EAcute] la wordlist cambia e \
RandomChoice opera su una lista diversa.",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["\n\n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["4",
  FontSize->24,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox[". Schema delle dipendenze funzionali\n",
  FontSize->25,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox["L\[CloseCurlyQuote]architettura del pacchetto HangmanGame \
\[EGrave] organizzata in modo gerarchico, dove l\[CloseCurlyQuote]interfaccia \
utente (UI) coordina diverse funzioni specializzate per la logica di gioco e \
la gestione dei dati. \[LineSeparator]Di seguito \[EGrave] riportata la \
struttura delle dipendenze:  \n\n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["1. Punto di Ingresso (Top Level)", "Subsubsection",
  FontSize->20,
  FontWeight->"Normal",
  FontColor->GrayLevel[0.1]],
 StyleBox["\n", "Subsubsection",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["GeneraInterfaccia[]", "Subsubsection",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": \n\[CapitalEGrave] l\[CloseCurlyQuote]unica  funzione pubblica \
del package. \[LineSeparator]Gestisce l\[CloseCurlyQuote]intero ciclo di vita \
del gioco (selezione difficolt\[AGrave], partita, bonus e classifica) tramite \
un \tDynamicModule che mantiene lo stato locale.\n\t\n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["2. Funzioni di Gestione e Logica (Livello Intermedio)",
  FontSize->20,
  FontWeight->"Normal",
  FontColor->GrayLevel[0.1]],
 StyleBox["\nLe seguenti funzioni sono richiamate direttamente dall\
\[CloseCurlyQuote]interfaccia per gestire le azioni \
dell\[CloseCurlyQuote]utente:\[LineSeparator]",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["GeneraEsercizio[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Richiamata all\[CloseCurlyQuote]avvio per selezionare una \
nazione dal dizionarioGeografia in base alla difficolt\[AGrave] scelta.  \n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["AggiornaStato[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Gestisce la logica di ogni mossa, verificando se la lettera \
\[EGrave] corretta e aggiornando punteggio ed errori. \n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["Suggerimento[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Rivela una lettera mancante penalizzando il punteggio; delega l\
\[CloseCurlyQuote]aggiornamento a ",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["AggiornaStato[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[". \n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["MostraClassificaGUI[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Crea la finestra di dialogo per il salvataggio dei record e la \
visualizzazione della graduatoria.  \n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["DisegnaImpiccato[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Funzione grafica che genera l\[CloseCurlyQuote]immagine dinamica \
in base al numero di errori correnti. \[LineSeparator]",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["MostraSoluzione[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[" e",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox[" Pulisci[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Gestiscono rispettivamente la resa del giocatore e il reset \
della partita corrente.  \n\n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["3. Utility e Persistenza (Livello Base)",
  FontSize->20,
  FontWeight->"Normal",
  FontColor->GrayLevel[0.1]],
 StyleBox["\nFunzioni di supporto che eseguono operazioni atomiche sui dati:\
\[LineSeparator]",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["InizializzaStato[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Crea il vettore di trattini bassi e spazi; \[EGrave] utilizzata \
da GeneraEsercizio e Pulisci.  \n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["SalvaRecord[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[" e ",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["RecuperaClassifica[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Gestiscono l\[CloseCurlyQuote]interazione con il file score.json \
per la persistenza dei punteggi.  \[LineSeparator]",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
 StyleBox["HaCaratteriNonAmmessiQ[]",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[0.1]],
 StyleBox[": Funzione di validazione per filtrare caratteri speciali non \
supportati dalla tastiera.  \n",
  FontSize->18,
  FontColor->GrayLevel[0.1]],
