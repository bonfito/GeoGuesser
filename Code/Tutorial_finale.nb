Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`Private`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<Pacchetto.wl\>\"", "]"}], ";"}], "\n", 
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cliccato", "=", "False"}], "}"}], ",", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<Avvia Gioco\>\"", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", "cliccato"}], ",", 
       RowBox[{
        RowBox[{"CellPrint", "[", 
         RowBox[{"ExpressionCell", "[", 
          RowBox[{
           RowBox[{"GeneraInterfaccia", "[", "]"}], ",", "\"\<Output\>\""}], 
          "]"}], "]"}], ";", 
        RowBox[{"cliccato", "=", "True"}], ";"}]}], "]"}], ",", 
     RowBox[{"Enabled", "->", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"!", "cliccato"}], "]"}]}], ",", 
     RowBox[{"Method", "->", "\"\<Queued\>\""}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"150", ",", "50"}], "}"}]}], ",", 
     RowBox[{"Background", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.1`", ",", "0.4`", ",", "0.9`"}], "]"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"{", 
       RowBox[{"White", ",", "Bold", ",", 
        RowBox[{"FontSize", "->", "16"}]}], "}"}]}]}], "]"}]}], 
  "]"}]}], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9858392419526634`*^9, 3.985839337558592*^9}},
 CellLabel->
  "In[276]:=",ExpressionUUID->"0e8b28e3-dab8-46e3-9dc0-eef3f2e64f9c"],

Cell[BoxData[
 DynamicModuleBox[{$CellContext`cliccato$$ = False}, 
  ButtonBox["\<\"Avvia Gioco\"\>",
   Appearance->Automatic,
   Background->RGBColor[0.1, 0.4, 0.9],
   BaseStyle->{
     GrayLevel[1], Bold, FontSize -> 16},
   ButtonFunction:>If[
     Not[$CellContext`cliccato$$], CellPrint[
       ExpressionCell[
        HangmanGame`GeneraInterfaccia[], "Output"]]; $CellContext`cliccato$$ = 
      True; Null],
   Enabled->Dynamic[
     Not[$CellContext`cliccato$$]],
   Evaluator->Automatic,
   ImageSize->{150, 50},
   Method->"Queued"],
  DynamicModuleValues:>{}]], "Output",
 CellChangeTimes->{{3.9875737932456217`*^9, 3.98757380544016*^9}, 
   3.987580284199943*^9, 3.987580344180171*^9, 3.987580658679132*^9},
 CellLabel->
  "Out[280]=",ExpressionUUID->"907a0ab8-9b63-49ba-ae84-5ec7625f62a3"]
}, Open  ]],

