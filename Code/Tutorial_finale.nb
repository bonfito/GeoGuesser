Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`Private`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<Pacchetto.wl\>\"", "]"}], ";"}], "\n", 
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cliccato", "=", "False"}], "}"}], ",", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<Avvia Gioco\>\"", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", "cliccato"}], ",", 
       RowBox[{
        RowBox[{"CellPrint", "[", 
         RowBox[{"ExpressionCell", "[", 
          RowBox[{
           RowBox[{"GeneraInterfaccia", "[", "]"}], ",", "\"\<Output\>\""}], 
          "]"}], "]"}], ";", 
        RowBox[{"cliccato", "=", "True"}], ";"}]}], "]"}], ",", 
     RowBox[{"Enabled", "->", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"!", "cliccato"}], "]"}]}], ",", 
     RowBox[{"Method", "->", "\"\<Queued\>\""}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"150", ",", "50"}], "}"}]}], ",", 
     RowBox[{"Background", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.1`", ",", "0.4`", ",", "0.9`"}], "]"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"{", 
       RowBox[{"White", ",", "Bold", ",", 
        RowBox[{"FontSize", "->", "16"}]}], "}"}]}]}], "]"}]}], 
  "]"}]}], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9858392419526634`*^9, 3.985839337558592*^9}},
 CellLabel->
  "In[261]:=",ExpressionUUID->"0e8b28e3-dab8-46e3-9dc0-eef3f2e64f9c"],

Cell[BoxData[
 DynamicModuleBox[{$CellContext`cliccato$$ = True}, 
  ButtonBox["\<\"Avvia Gioco\"\>",
   Appearance->Automatic,
   Background->RGBColor[0.1, 0.4, 0.9],
   BaseStyle->{
     GrayLevel[1], Bold, FontSize -> 16},
   ButtonFunction:>If[
     Not[$CellContext`cliccato$$], CellPrint[
       ExpressionCell[
        HangmanGame`GeneraInterfaccia[], "Output"]]; $CellContext`cliccato$$ = 
      True; Null],
   Enabled->Dynamic[
     Not[$CellContext`cliccato$$]],
   Evaluator->Automatic,
   ImageSize->{150, 50},
   Method->"Queued"],
  DynamicModuleValues:>{}]], "Output",
 CellChangeTimes->{{3.9875737932456217`*^9, 3.98757380544016*^9}},
 CellLabel->
  "Out[265]=",ExpressionUUID->"1c491ccb-4b90-4d05-9979-4b53efe0d0ed"],

Cell[BoxData[
 DynamicModuleBox[{HangmanGame`Private`seed$$ = 12, 
  HangmanGame`Private`seedError$$ = "", HangmanGame`Private`fase$$ = "gioco", 
  HangmanGame`Private`gamemode$$ = 2, HangmanGame`Private`parola$$ = {
  "b", "u", "r", "u", "n", "d", "i"}, HangmanGame`Private`stato$$ = {
  "b", "u", "r", "u", "n", "d", "i"}, HangmanGame`Private`errori$$ = {}, 
  HangmanGame`Private`score$$ = 170, HangmanGame`Private`messaggio$$ = 
  "Lettera corretta!", HangmanGame`Private`maxErrori$$ = 6, 
  HangmanGame`Private`opzioniBonus$$ = {
  "saint john's", "citega", "suva", "damasco"}, 
  HangmanGame`Private`faseBonusCompletata$$ = True, 
  HangmanGame`Private`messaggioBonus$$ = 
  "Risposta corretta! Hai guadagnato 50 punti extra."}, 
  DynamicBox[ToBoxes[
    Switch[HangmanGame`Private`fase$$, "selezione", 
     Column[{
       Style["Seleziona la difficolt\[AGrave]", Bold, White, 20], 
       Row[{
         RadioButton[
          Dynamic[HangmanGame`Private`gamemode$$], 1], 
         Style[" Facile  ", White, 16], 
         RadioButton[
          Dynamic[HangmanGame`Private`gamemode$$], 2], 
         Style[" Media   ", White, 16], 
         RadioButton[
          Dynamic[HangmanGame`Private`gamemode$$], 3], 
         Style[" Difficile", White, 16]}], 
       Row[{
         Style["Seed (opzionale): ", White], 
         InputField[
          Dynamic[
          HangmanGame`Private`seed$$, ({
            HangmanGame`Private`seed$$, HangmanGame`Private`seedError$$} = If[
             Or[
              StringMatchQ[#, 
               Repeated[DigitCharacter]], 
              StringMatchQ[#, ""]], {#, ""}, {
             HangmanGame`Private`seed$$, 
              "Inserire solo numeri naturali (0, 1, 2, ...)."}])& ], String, 
          FieldHint -> "Inserire un numero naturale", ContinuousAction -> 
          True]}], 
       Dynamic[
        If[HangmanGame`Private`seedError$$ != "", 
         Style[HangmanGame`Private`seedError$$, Red, Italic], ""]], 
       Button["Inizia partita", 
        Module[{}, If[
           And[
            StringQ[HangmanGame`Private`seed$$], HangmanGame`Private`seed$$ != 
            ""], HangmanGame`Private`seed$$ = 
           ToExpression[HangmanGame`Private`seed$$], 
           HangmanGame`Private`seed$$ = Automatic]; {
           HangmanGame`Private`parola$$, HangmanGame`Private`stato$$, 
            HangmanGame`Private`errori$$, HangmanGame`Private`score$$} = 
          HangmanGame`Private`GeneraEsericizio[
           HangmanGame`Private`gamemode$$, HangmanGame`Private`seed$$]; 
         HangmanGame`Private`fase$$ = "gioco"; 
         HangmanGame`Private`messaggio$$ = ""; 
         HangmanGame`Private`opzioniBonus$$ = {}; 
         HangmanGame`Private`faseBonusCompletata$$ = False; 
         HangmanGame`Private`messaggioBonus$$ = ""; Null], 
        ImageSize -> {150, 60}, BaseStyle -> {FontSize -> 16, Bold, White}, 
        Background -> RGBColor[0.1, 0.4, 0.9]]}, Spacings -> 2], "gioco", 
     Column[{
       Style["Gioco dell'impiccato", Bold, 28, White], 
       Spacer[10], 
       Dynamic[
        Row[{
          Style["Punteggio: ", White, 14], 
          Style[HangmanGame`Private`score$$, Blue, Bold, 14]}]], 
       Spacer[10], 
       Dynamic[
        Row[
         Riffle[
          Map[Which[# === " ", 
            Style["   ", Bold, 28], # === "_", 
            Style[" _ ", Gray, Bold, 28], True, 
            Style[#, Bold, 28, White]]& , HangmanGame`Private`stato$$], 
          " "]]], 
       Spacer[10], 
       Row[{
         Button[
         "Suggerimento", {
           HangmanGame`Private`stato$$, HangmanGame`Private`errori$$, 
            HangmanGame`Private`score$$} = 
          HangmanGame`Private`Suggerimento[
           HangmanGame`Private`parola$$, HangmanGame`Private`stato$$, 
            HangmanGame`Private`errori$$, HangmanGame`Private`score$$, 
            HangmanGame`Private`gamemode$$], Enabled -> And[
            MemberQ[HangmanGame`Private`stato$$, "_"], 
            Length[HangmanGame`Private`errori$$] < 
            HangmanGame`Private`maxErrori$$], 
          BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
          RGBColor[0.8, 0.5, 0.], ImageSize -> {140, 38}], 
         Spacer[20], 
         Button[
         "Mostra soluzione", 
          HangmanGame`Private`MostraSoluzione[
           HangmanGame`Private`parola$$]; {
            HangmanGame`Private`stato$$, HangmanGame`Private`fase$$, 
             HangmanGame`Private`messaggio$$, 
             HangmanGame`Private`seedError$$} = {
            HangmanGame`Private`parola$$, "selezione", "", ""}, 
          BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
          RGBColor[0.4, 0.1, 0.6], ImageSize -> {160, 38}]}], 
       Dynamic[
        Row[{
          Style["Lettere sbagliate: ", White], 
          Style[
           StringJoin[
            Riffle[HangmanGame`Private`errori$$, ", "]], Red, Bold]}]], 
       Dynamic[
        Row[{
          Style["Errori: ", White], 
          Style[
           Length[HangmanGame`Private`errori$$], Red, Bold], 
          Style["/", White], HangmanGame`Private`maxErrori$$}]], 
       Dynamic[
        Style[HangmanGame`Private`messaggio$$, 
         RGBColor[0.1, 0.4, 0.9], Bold]], 
       Dynamic[
        HangmanGame`Private`DisegnaImpiccato[
         Length[HangmanGame`Private`errori$$]]], 
       Spacer[10], 
       Dynamic[
        Column[
         Map[Row[
           Join[{
             Spacer[Part[#, 1] 25]}, 
            Table[
             With[{HangmanGame`Private`l$ = HangmanGame`Private`lettera}, 
              Button[
               Style[HangmanGame`Private`l$, White, Bold, FontSize -> 16], 
               Module[{HangmanGame`Private`guess$ = ToLowerCase[
                   StringTrim[HangmanGame`Private`l$]]}, {
                  HangmanGame`Private`stato$$, HangmanGame`Private`errori$$, 
                   HangmanGame`Private`score$$} = 
                 HangmanGame`Private`AggiornaStato[
                  HangmanGame`Private`parola$$, HangmanGame`Private`stato$$, 
                   HangmanGame`Private`guess$, HangmanGame`Private`score$$, 
                   HangmanGame`Private`gamemode$$, 
                   HangmanGame`Private`errori$$]; 
                HangmanGame`Private`messaggio$$ = If[
                   MemberQ[
                   HangmanGame`Private`parola$$, HangmanGame`Private`guess$], 
                   "Lettera corretta!", "Lettera sbagliata!"]; Null], Enabled -> 
               And[
                 Not[
                  MemberQ[
                   Join[
                   HangmanGame`Private`stato$$, HangmanGame`Private`errori$$], 
                   ToLowerCase[HangmanGame`Private`l$]]], 
                 MemberQ[HangmanGame`Private`stato$$, "_"], 
                 Length[HangmanGame`Private`errori$$] < 
                 HangmanGame`Private`maxErrori$$], Background -> Which[
                 MemberQ[HangmanGame`Private`stato$$, 
                  ToLowerCase[HangmanGame`Private`l$]], 
                 RGBColor[0.2, 0.7, 0.3], 
                 MemberQ[HangmanGame`Private`errori$$, 
                  ToLowerCase[HangmanGame`Private`l$]], 
                 RGBColor[0.75, 0.15, 0.15], True, 
                 RGBColor[0.15, 0.35, 0.75]], ImageSize -> {48, 48}]], {
             HangmanGame`Private`lettera, 
              Part[#, 2]}]], 
           Spacer[4]]& , HangmanGame`Private`righeTastiera], Spacings -> 
         0.8]], 
       Dynamic[
        If[
         Or[
         HangmanGame`Private`stato$$ === HangmanGame`Private`parola$$, 
          Length[HangmanGame`Private`errori$$] >= 
          HangmanGame`Private`maxErrori$$], 
         Column[{
           If[HangmanGame`Private`stato$$ === HangmanGame`Private`parola$$, 
            If[
             Not[HangmanGame`Private`faseBonusCompletata$$], 
             If[HangmanGame`Private`opzioniBonus$$ === {}, 
               
               Module[{
                HangmanGame`Private`corretta$ = 
                 HangmanGame`Private`dizionarioGeografia[
                   StringJoin[HangmanGame`Private`parola$$]], 
                 HangmanGame`Private`sbagliate$}, 
                HangmanGame`Private`sbagliate$ = RandomSample[
                   DeleteCases[
                    Values[HangmanGame`Private`dizionarioGeografia], 
                    HangmanGame`Private`corretta$], 3]; 
                HangmanGame`Private`opzioniBonus$$ = RandomSample[
                   
                   Join[{HangmanGame`Private`corretta$}, 
                    HangmanGame`Private`sbagliate$]]; Null]]; Column[{
                Spacer[10], 
                Style["Hai vinto!", Green, Bold, 18], 
                Style["Domanda Bonus (+50 punti extra!):", Purple, Bold, 18], 
                Spacer[10], 
                Row[{
                  Style["Qual \[EGrave] la capitale di ", White, 16], 
                  Style[
                   Capitalize[
                    StringJoin[HangmanGame`Private`parola$$]], White, Bold, 
                   16], 
                  Style["?", White, 16]}], 
                Row[
                 Riffle[
                  Map[Button[
                    Capitalize[#], 
                    If[# === HangmanGame`Private`dizionarioGeografia[
                    StringJoin[HangmanGame`Private`parola$$]], 
                    HangmanGame`Private`score$$ = 
                    HangmanGame`Private`score$$ + 50; 
                    HangmanGame`Private`messaggioBonus$$ = 
                    "Risposta corretta! Hai guadagnato 50 punti extra.", 
                    HangmanGame`Private`messaggioBonus$$ = 
                    "Sbagliato! La risposta corretta era: " <> Capitalize[
                    HangmanGame`Private`dizionarioGeografia[
                    StringJoin[HangmanGame`Private`parola$$]]]]; 
                    HangmanGame`Private`faseBonusCompletata$$ = True; Null]& ,
                    HangmanGame`Private`opzioniBonus$$], 
                  Spacer[10]]]}, Alignment -> Center], 
             Column[{
               Spacer[10], 
               Style[HangmanGame`Private`messaggioBonus$$, 
                If[
                 StringContainsQ[
                 HangmanGame`Private`messaggioBonus$$, "punti extra"], Green, 
                 Red], Bold], 
               Spacer[10], 
               Button["Salva e Mostra Classifica", 
                SessionSubmit[
                 HangmanGame`Private`MostraClassificaGUI[
                 HangmanGame`Private`score$$]], 
                BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
                RGBColor[0.1, 0.4, 0.9], ImageSize -> {240, 42}]}, Alignment -> 
              Center]], 
            Column[{
              Spacer[10], 
              Style["Hai perso! La nazione era: " <> Capitalize[
                 StringJoin[HangmanGame`Private`parola$$]], Red, Bold], 
              Spacer[10], 
              Button["Salva e Mostra Classifica", 
               SessionSubmit[
                HangmanGame`Private`MostraClassificaGUI[
                HangmanGame`Private`score$$]], 
               BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
               RGBColor[0.1, 0.4, 0.9], ImageSize -> {240, 42}]}, Alignment -> 
             Center]], 
           Spacer[25], 
           Button[
           "Pulisci Campi", {
              HangmanGame`Private`stato$$, HangmanGame`Private`errori$$, 
               HangmanGame`Private`score$$} = 
             HangmanGame`Private`Pulisci[HangmanGame`Private`parola$$]; 
            HangmanGame`Private`opzioniBonus$$ = {}; 
            HangmanGame`Private`faseBonusCompletata$$ = False; 
            HangmanGame`Private`messaggioBonus$$ = ""; Null, 
            BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
            RGBColor[0.2, 0.5, 0.7], ImageSize -> {150, 38}]}], ""]], 
       Button["Nuova partita", 
        Module[{}, HangmanGame`Private`fase$$ = "selezione"; 
         HangmanGame`Private`messaggio$$ = ""; 
         HangmanGame`Private`seedError$$ = ""; 
         HangmanGame`Private`opzioniBonus$$ = {}; 
         HangmanGame`Private`faseBonusCompletata$$ = False; 
         HangmanGame`Private`messaggioBonus$$ = ""; Null], 
        BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
        RGBColor[0.3, 0.3, 0.8], ImageSize -> {150, 40}]}]], StandardForm],
   ImageSizeCache->{
    440.6687571144106, {341.99136049299983`, 346.3344023169905}}],
  DynamicModuleValues:>{}]], "Output",
 CellChangeTimes->{
  3.9875765784224415`*^9},ExpressionUUID->"7272f308-560a-8e4c-9a55-\
d23743fd9fa2"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Indice",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["\n",
  FontSize->20,
  FontWeight->"Bold"],
 StyleBox["Introduzione\n",
  FontSize->20,
  FontWeight->"Bold",
  FontColor->GrayLevel[1]],
 StyleBox["I. Regole del gioco\nII Guida all'Uso dell'Interfaccia\nIII. \
Livello Bonus e Classifica\nIV. Approfondimenti\nV. Bibliografia e Sitografia\
\nVI. Commenti e lavoro futuro",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[1]],
 "\n"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.9858360014789486`*^9, 3.9858360306143284`*^9}, {
   3.9858360732825184`*^9, 3.985836145124634*^9}, {3.9858361954915047`*^9, 
   3.9858361969220734`*^9}, {3.9858362329447994`*^9, 
   3.9858362673060646`*^9}, {3.985836327335438*^9, 3.985836353543562*^9}, {
   3.9858363906426277`*^9, 3.985836483617651*^9}, {3.9858374962166767`*^9, 
   3.98583750173946*^9}, {3.9858375866057167`*^9, 3.985837630997324*^9}, {
   3.985837684023142*^9, 3.9858376858858986`*^9}, {3.9858377358055496`*^9, 
   3.985837739437933*^9}, {3.9858378073290215`*^9, 3.9858378224481792`*^9}, {
   3.985837871715273*^9, 3.9858379528118877`*^9}, {3.9858386000979633`*^9, 
   3.9858386326541595`*^9}, 3.9873393814061832`*^9, {3.98740915493186*^9, 
   3.98740919761302*^9}},
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"a2cf4ed4-8e98-2244-a2be-22e64bc08852"],

Cell[TextData[{
 StyleBox["Introduzione\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Benvenuto in Geographic Hangman! \nQuesto progetto \[EGrave] una \
rivisitazione interattiva e didattica del classico gioco dell'impiccato.\n\
L'obiettivo dell'applicativo \[EGrave] unire il ragionamento logico e la \
conoscenza geografica. Il gioco \[EGrave] progettato per essere intuitivo e \
non richiede alcuna competenza informatica pregressa: tutto \[EGrave] gestito \
da una comoda interfaccia grafica.Mettiti alla prova, indovina le nazioni \
nascoste e scala la classifica globale!",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}, {3.9874096802827625`*^9, 3.987409693324892*^9}, {
  3.987423139293293*^9, 3.9874231510466156`*^9}},
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"c6da6e88-2037-be42-abe5-6f1cb2d9dae3"],

Cell[TextData[{
 StyleBox["I. Regole del gioco\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Il computer sceglie casualmente il nome di una Nazione. Il tuo \
compito \[EGrave] indovinare la parola lettera per lettera prima di \
commettere 6 errori (che porteranno al completamento del disegno \
dell'impiccato).\n\nLa difficolt\[AGrave] (Facile, Media, Difficile) \
influenza tre fattori:\n\t 1. a difficolt\[AGrave] pi\[UGrave] alte \
corrispondono nomi di nazioni pi\[UGrave] lunghi.\n\t 2. Punteggio: Riceverai \
pi\[UGrave] punti per ogni lettera corretta se giochi a difficolt\[AGrave] \
elevata.\n\t 3. Penalit\[AGrave]: Richiedere un suggerimento coster\[AGrave] \
pi\[UGrave] punti ai livelli di difficolt\[AGrave] maggiori.",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}, {3.9873512930195704`*^9, 3.987351294208749*^9}},
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"c1d52f11-e0af-304c-b931-3923f58b8f58"],

Cell[TextData[{
 StyleBox["II. Guida all'Uso dell'Interfaccia\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["L'interfaccia si divide in due fasi principali. Ecco come \
utilizzare tutte le funzionalit\[AGrave] a tua disposizione:",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n\n",
  FontSize->17],
 StyleBox["1. Fase di Selezione (Genera Esercizio e Seed)\n",
  FontSize->25,
  FontColor->RGBColor[0.98, 0.75, 0.2]],
 StyleBox["\[Bullet] Seleziona la difficolt\[AGrave]: Usa i bottoni per \
scegliere il livello (Facile, Media, Difficile).\n\[Bullet] Seed (Opzionale): \
Puoi inserire un numero intero nel campo di testo. Inserendo lo stesso numero \
in partite future,   il computer generer\[AGrave] esattamente la stessa \
parola. \[CapitalEGrave] utile per sfidare un amico ad armi pari!\n\[Bullet] \
Clicca su INIZIA GIOCO per generare l'esercizio.",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n",
  FontSize->17],
 StyleBox["\n 2. Fase di Gioco (Verifica Risultato)\n",
  FontSize->25,
  FontColor->RGBColor[0.98, 0.75, 0.2]],
 StyleBox["\[Bullet] Tastiera a schermo: Clicca sulle lettere per fare un \
tentativo. Se la lettera \[EGrave] corretta (Verifica Risultato positiva) \
diventer\[AGrave] verde e guadagnerai punti; \n  se \[EGrave] sbagliata, \
diventer\[AGrave] rossa e verr\[AGrave] aggiunto un pezzo al patibolo.\n\
\[Bullet] Suggerimento: Se sei bloccato, clicca su \"Suggerimento\". Il \
computer sveler\[AGrave] una lettera mancante, ma ti verr\[AGrave] sottratto \
del punteggio.\n\[Bullet] Mostra Soluzione: Se vuoi arrenderti, clicca su \
questo bottone. Un pop-up ti riveler\[AGrave] la parola nascosta e la partita \
terminer\[AGrave].\n\[Bullet] Pulisci Campi: Questo tasto azzera i tuoi \
tentativi, gli errori e il punteggio per la nazione corrente, permettendoti \
di ricominciare da capo la stessa parola (utile dopo aver visto la \
soluzione).",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}, {3.987351461665354*^9, 3.987351461924592*^9}},
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"8b9859a0-bc1f-4913-8f0f-331c59ce4f3b"],

Cell[TextData[{
 StyleBox["III. Livello Bonus e Interfaccia\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Se riesci a indovinare la Nazione senza farti impiccare, avrai \
accesso a una Domanda Bonus. Ti verranno proposti 4 bottoni a scelta multipla \
per indovinare la Capitale di quella specifica Nazione. \nSe indovini, \
guadagnerai ben 50 punti extra!\nAl termine della partita (vittoria o \
sconfitta), potrai salvare il tuo nome e confrontare il tuo punteggio nella \
Classifica Globale dei migliori 50 giocatori.",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n",
  FontSize->17,
  FontColor->GrayLevel[0.88]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
  3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
  3.9858387681869087`*^9}},
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"b8a5fdc3-dfff-48f4-accd-b0d2c30c0c9d"],

Cell[TextData[{
 StyleBox["IV.  Approfondimenti\n\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["1. Storia",
  FontSize->25,
  FontColor->RGBColor[0.98, 0.75, 0.2]],
 StyleBox["\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Tony Augarde sostiene che il gioco pare essere stato inventato \
nell\[CloseCurlyQuote]epoca vittoriana (vedi \[OpenCurlyDoubleQuote]The \
Oxford Guide to Word Games\[CloseCurlyDoubleQuote], Oxford University Press). \
Il gioco viene citato anche nel libro \[OpenCurlyDoubleQuote]Traditional \
Games\[CloseCurlyDoubleQuote] di Alice Bertha Gomme 1894, col nome \
\[OpenCurlyDoubleQuote]Uccelli, belve e pesci.\[CloseCurlyDoubleQuote] Le \
regole sono quasi uguali, eccetto che il giocatore che sceglie la parola deve \
scriverne subito la prima e l\[CloseCurlyQuote]ultima lettera [4].\n\n",
  FontSize->18,
  FontColor->GrayLevel[1]],
 StyleBox["2",
  FontSize->24,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox[". Strategia\n",
  FontSize->25,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox["L\[CloseCurlyQuote]unica strategia generale per questo gioco pu\
\[OGrave] basarsi su una tabella della frequenza delle varie lettere in \
italiano (o nella lingua in cui si gioca); tuttavia, questa idea si presta \
altrettanto bene a essere usato con scopi opposti dal giocatore che sceglie \
la parola (es., una parola come \[OpenCurlyDoubleQuote]hobby\
\[CloseCurlyDoubleQuote] potrebbe essere molto difficile da immaginare \
proprio perch\[EAcute] contiene poche lettere, e almeno due molto poco \
frequenti).\n\nUna buona tattica pu\[OGrave] essere psicologica, ossia \
conoscere il proprio avversario e i suoi campi d\[CloseCurlyQuote]interesse \
[4].\n\n",
  FontSize->18,
  FontColor->GrayLevel[1]],
 StyleBox["3",
  FontSize->24,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox[". Schema delle Dipendenze Funzionali\n",
  FontSize->25,
  FontColor->RGBColor[1, 0.75, 0]],
 StyleBox["L\[CloseCurlyQuote]architettura del pacchetto HangmanGame \
\[EGrave] organizzata in modo gerarchico, dove l\[CloseCurlyQuote]interfaccia \
utente (UI) coordina diverse funzioni specializzate per la logica di gioco e \
la gestione dei dati. \[LineSeparator]Di seguito \[EGrave] riportata la \
struttura delle dipendenze:  \n\n",
  FontSize->18,
  FontColor->GrayLevel[1]],
 StyleBox["1. Punto di Ingresso (Top Level)GeneraInterfaccia[]", 
  "Subsubsection",
  FontSize->18,
  FontColor->GrayLevel[1]],
 StyleBox[": \n\[CapitalEGrave] l\[CloseCurlyQuote]unica  funzione pubblica \
del package. \[LineSeparator]Gestisce l\[CloseCurlyQuote]intero ciclo di vita \
del gioco (selezione difficolt\[AGrave], partita, bonus e classifica) tramite \
un \tDynamicModule che mantiene lo stato locale.\n\t\n2. Funzioni di Gestione \
e Logica (Livello Intermedio)\nLe seguenti funzioni sono richiamate \
direttamente dall\[CloseCurlyQuote]interfaccia per gestire le azioni dell\
\[CloseCurlyQuote]utente:GeneraEsercizio[]: Richiamata \
all\[CloseCurlyQuote]avvio per selezionare una nazione dal \
dizionarioGeografia in base alla difficolt\[AGrave] scelta.  \n\
AggiornaStato[]: Gestisce la logica di ogni mossa, verificando se la lettera \
\[EGrave] corretta e aggiornando punteggio ed errori. \nSuggerimento[]: \
Rivela una lettera mancante penalizzando il punteggio; delega l\
\[CloseCurlyQuote]aggiornamento a AggiornaStato[]. \nMostraClassificaGUI[]: \
Crea la finestra di dialogo per il salvataggio dei record e la \
visualizzazione della graduatoria.  \nDisegnaImpiccato[]: Funzione grafica \
che genera l\[CloseCurlyQuote]immagine dinamica in base al numero di errori \
correnti. \[LineSeparator]MostraSoluzione[] e Pulisci[]: Gestiscono \
rispettivamente la resa del giocatore e il reset della partita corrente.  \n\n\
3. Utility e Persistenza (Livello Base)\nFunzioni di supporto che eseguono \
operazioni atomiche sui dati:InizializzaStato[]: Crea il vettore di trattini \
bassi e spazi; \[EGrave] utilizzata da GeneraEsercizio e Pulisci.  \n\
SalvaRecord[] e RecuperaClassifica[]: Gestiscono \
l\[CloseCurlyQuote]interazione con il file score.json per la persistenza dei \
punteggi.  \[LineSeparator]HaCaratteriNonAmmessiQ[]: Funzione di validazione \
per filtrare caratteri speciali non supportati dalla tastiera.  \n",
  FontSize->18,
  FontColor->GrayLevel[1]],
 Cell[BoxData[
  GraphicsBox[
   TagBox[RasterBox[CompressedData["
