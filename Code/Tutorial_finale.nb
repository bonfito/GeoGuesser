Cell[TextData[{
 StyleBox[" Gioco\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["\t1. Clicca il bottone \"Avvia Gioco\" che apparir\[AGrave] qui \
sotto \n\t2. Se appare \"Enable Dynamics?\", accettalo \n\t 3. Se non appare \
il bottone: dal Menu vai su Evaluate -> Evaluate Notebook e apparir\[AGrave] \
qui in basso",
  FontSize->17,
  FontColor->GrayLevel[1]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
