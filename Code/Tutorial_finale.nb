Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`Private`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<Pacchetto.wl\>\"", "]"}], ";"}], "\n", 
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cliccato", "=", "False"}], "}"}], ",", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<Avvia Gioco\>\"", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", "cliccato"}], ",", 
       RowBox[{
        RowBox[{"CellPrint", "[", 
         RowBox[{"ExpressionCell", "[", 
          RowBox[{
           RowBox[{"GeneraInterfaccia", "[", "]"}], ",", "\"\<Output\>\""}], 
          "]"}], "]"}], ";", 
        RowBox[{"cliccato", "=", "True"}], ";"}]}], "]"}], ",", 
     RowBox[{"Enabled", "->", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"!", "cliccato"}], "]"}]}], ",", 
     RowBox[{"Method", "->", "\"\<Queued\>\""}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"150", ",", "50"}], "}"}]}], ",", 
     RowBox[{"Background", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.1`", ",", "0.4`", ",", "0.9`"}], "]"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"{", 
       RowBox[{"White", ",", "Bold", ",", 
        RowBox[{"FontSize", "->", "16"}]}], "}"}]}]}], "]"}]}], 
  "]"}]}], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9858392419526634`*^9, 3.985839337558592*^9}},
 CellLabel->
  "In[261]:=",ExpressionUUID->"0e8b28e3-dab8-46e3-9dc0-eef3f2e64f9c"],

Cell[BoxData[
 DynamicModuleBox[{$CellContext`cliccato$$ = False}, 
  ButtonBox["\<\"Avvia Gioco\"\>",
   Appearance->Automatic,
   Background->RGBColor[0.1, 0.4, 0.9],
   BaseStyle->{
     GrayLevel[1], Bold, FontSize -> 16},
   ButtonFunction:>If[
     Not[$CellContext`cliccato$$], CellPrint[
       ExpressionCell[
        HangmanGame`GeneraInterfaccia[], "Output"]]; $CellContext`cliccato$$ = 
      True; Null],
   Enabled->Dynamic[
     Not[$CellContext`cliccato$$]],
   Evaluator->Automatic,
   ImageSize->{150, 50},
   Method->"Queued"],
  DynamicModuleValues:>{}]], "Output",
 CellChangeTimes->{{3.9875737932456217`*^9, 3.98757380544016*^9}},
 CellLabel->
  "Out[265]=",ExpressionUUID->"1c491ccb-4b90-4d05-9979-4b53efe0d0ed"]
}, Open  ]],

Cell[TextData[{
 StyleBox["Indice",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["\n",
  FontSize->20,
  FontWeight->"Bold"],
 StyleBox["Introduzione\n",
  FontSize->20,
  FontWeight->"Bold",
  FontColor->GrayLevel[1]],
 StyleBox["I. Regole del gioco\nII Guida all'Uso dell'Interfaccia\nIII. \
Livello Bonus e Classifica\nIV. Approfondimenti\nV. Bibliografia e Sitografia\
\nVI. Commenti e lavoro futuro",
  FontSize->18,
  FontWeight->"Bold",
  FontColor->GrayLevel[1]],
 "\n"
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
