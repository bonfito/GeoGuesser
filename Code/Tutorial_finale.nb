Cell[TextData[{
 StyleBox[" Gioco\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Per avviare il gioco : \n\t 1. Se appare \"Enable Dynamics?\", \
accettalo \n\t 2. Dal menu: Evaluation \[RightArrow] Evaluate Notebook \n\t \
3. Clicca il bottone \"Avvia Gioco\" che apparir\[AGrave] qui sotto",
  FontSize->17,
  FontColor->GrayLevel[1]]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
   3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
   3.9858388067837715`*^9}, {3.9858389303471565`*^9, 3.985838983171753*^9}, 
   3.9858390663128757`*^9, 3.9858391635457516`*^9, {3.9858392090279865`*^9, 
   3.985839231116436*^9}, {3.985840146632084*^9, 3.9858401709332104`*^9}, {
   3.985840228906309*^9, 3.9858402553834953`*^9}, {3.9873402088382893`*^9, 
   3.9873402378403463`*^9}},
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"582b1ab8-2703-4c05-9eef-e6ab983f7114"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<HangmanGame`Private`*\>\"", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"SetDirectory", "[", 
   RowBox[{"NotebookDirectory", "[", "]"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Get", "[", "\"\<Pacchetto_styled.wl\>\"", "]"}], ";"}], "\n", 
 RowBox[{"DynamicModule", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cliccato", "=", "False"}], "}"}], ",", 
   RowBox[{"Button", "[", 
    RowBox[{"\"\<Avvia Gioco\>\"", ",", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"!", "cliccato"}], ",", 
       RowBox[{
        RowBox[{"CellPrint", "[", 
         RowBox[{"ExpressionCell", "[", 
          RowBox[{
           RowBox[{"GeneraInterfaccia", "[", "]"}], ",", "\"\<Output\>\""}], 
          "]"}], "]"}], ";", 
        RowBox[{"cliccato", "=", "True"}], ";"}]}], "]"}], ",", 
     RowBox[{"Enabled", "->", 
      RowBox[{"Dynamic", "[", 
       RowBox[{"!", "cliccato"}], "]"}]}], ",", 
     RowBox[{"Method", "->", "\"\<Queued\>\""}], ",", 
     RowBox[{"ImageSize", "->", 
      RowBox[{"{", 
       RowBox[{"150", ",", "50"}], "}"}]}], ",", 
     RowBox[{"Background", "->", 
      RowBox[{"RGBColor", "[", 
       RowBox[{"0.1`", ",", "0.4`", ",", "0.9`"}], "]"}]}], ",", 
     RowBox[{"BaseStyle", "->", 
      RowBox[{"{", 
       RowBox[{"White", ",", "Bold", ",", 
        RowBox[{"FontSize", "->", "16"}]}], "}"}]}]}], "]"}]}], 
  "]"}]}], "Input",
 CellOpen->False,
 CellChangeTimes->{{3.9858392419526634`*^9, 3.985839337558592*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"0e8b28e3-dab8-46e3-9dc0-eef3f2e64f9c"],

Cell[BoxData[
 DynamicModuleBox[{$CellContext`cliccato$$ = False}, 
  ButtonBox["\<\"Avvia Gioco\"\>",
   Appearance->Automatic,
   Background->RGBColor[0.1, 0.4, 0.9],
   BaseStyle->{
     GrayLevel[1], Bold, FontSize -> 16},
   ButtonFunction:>If[
     Not[$CellContext`cliccato$$], CellPrint[
       ExpressionCell[
        HangmanGame`GeneraInterfaccia[], "Output"]]; $CellContext`cliccato$$ = 
      True; Null],
   Enabled->Dynamic[
     Not[$CellContext`cliccato$$]],
   Evaluator->Automatic,
   ImageSize->{150, 50},
   Method->"Queued"],
  DynamicModuleValues:>{}]], "Output",
 CellChangeTimes->{3.987415634359707*^9, 3.9874231115401287`*^9},
 CellLabel->"Out[5]=",ExpressionUUID->"9f90e0ff-e742-0949-b25a-e95fd331e48b"]
}, Open  ]],

