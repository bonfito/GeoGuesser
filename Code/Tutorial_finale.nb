Cell[TextData[{
 StyleBox["V. Bibliografia e Sitografia\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Per lo sviluppo di questo progetto e la comprensione delle \
funzioni di interfaccia dinamica, ci siamo avvalsi della seguente \
documentazione:\n[1] Wolfram Language & System Documentation Center, \
DynamicModule. https://reference.wolfram.com/language/ref/DynamicModule.html\n\
[2] Wolfram Language & System Documentation Center, Import/Export. \
https://reference.wolfram.com/language/guide/ImportingAndExporting.html\n[3] \
Dizionario Geografico: Lista delle Nazioni e Capitali del Mondo.\n[4] \
Wikipedia: https://it.wikipedia.org/wiki/L%27impiccato\n[5] Wolfram Language \
& System Documentation Center, Line. \
https://reference.wolfram.com/language/ref/Line.html?q=Line\n[6] Wolfram \
Language & System Documentation Center, Circle. \
https://reference.wolfram.com/language/ref/Circle.html\n[7] Wolfram Language \
& System Documentation Center, Pane. \
https://reference.wolfram.com/language/ref/Pane.html\n[8] Wolfram Language & \
System Documentation Center, Grid. \
https://reference.wolfram.com/language/ref/Grid.html",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.985838668708351*^9, 3.985838669514038*^9}, {
   3.985838704020897*^9, 3.9858387085672665`*^9}, {3.985838760582161*^9, 
   3.9858387681869087`*^9}, 3.9874098133055325`*^9, {3.987410893193001*^9, 
   3.987410914444002*^9}},
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"79d8cb74-d9a4-4994-b884-9d2a243c0812"],

Cell[TextData[{
 StyleBox["VI. Commenti e lavoro futuro\n",
  FontSize->32,
  FontWeight->"Bold",
  FontColor->RGBColor[0.93, 0.27, 0.27]],
 StyleBox["Commenti Tecnici : \n",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["Lo sviluppo del progetto ha richiesto un'attenta analisi per \
quanto riguarda l'aggiornamento dinamico dell'interfaccia utente in \
Mathematica. Per evitare \n conflitti di \"shadowing\" e blocchi causati da \
finestre di pop-up sovrapposte (come la conferma del nome in classifica), \
abbiamo implementato   una \"Macchina a Stati\" (faseClassifica) all'interno \
del DynamicModule. La persistenza dei dati \[EGrave] gestita in modo  tramite \
lettura/scrittura  di file score.json locali, utilizzando il comando Quiet \
per prevenire crash derivati da file corrotti o inesistenti.\n",
  FontColor->GrayLevel[1]],
 StyleBox["\nLavoro Futuro : \n\[Bullet] Inserimento di un timer che \
introduca un moltiplicatore di punteggio per premiare la velocit\[AGrave] di \
risposta.\n\[Bullet] Ampliamento del dizionario con altre categorie \
didattiche (es. Chimica: Elemento e Formula; Storia: Evento e Data).\n\
\[Bullet] Supporto per account utente con cronologia delle partite precedenti \
per tenere traccia dei propri miglioramenti.",
  FontSize->17,
  FontColor->GrayLevel[1]],
 StyleBox["\n",
  FontSize->17]
}], "Text",
 CellFrame->{{4, 0}, {0, 0}},
 CellMargins->{{50, 50}, {6, 6}},
 CellFrameMargins->{{20, 20}, {14, 14}},
 CellFrameColor->RGBColor[0.93, 0.27, 0.27],
 CellChangeTimes->{{3.987353539626474*^9, 3.9873535398047123`*^9}, 
   3.9873540896158133`*^9, 3.987409816505165*^9},
 FontSize->17,
 Background->RGBColor[
  0.1, 0.1, 0.18],ExpressionUUID->"db7db663-06b5-4cc5-b716-e753132fb25d"]
},
