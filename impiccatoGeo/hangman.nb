Cell[TextData[{
 "La funzione principale ",
 StyleBox["GeneraInterfaccia[]", "Code"],
 " si trova al vertice, fungendo da punto di ingresso per \
l\[CloseCurlyQuote]interfaccia utente. Da essa dipendono direttamente \
funzioni operative come ",
 StyleBox["GeneraEsercizio[]", "Code"],
 ", che gestisce la generazione del contenuto del gioco, e ",
 StyleBox["MostraClassificaGUI[]", "Code"],
 ", responsabile della visualizzazione della classifica.\n\nLe funzioni",
 StyleBox[" Suggerimento[]", "Code"],
 ", ",
 StyleBox["MostraSoluzione[]", "Code"],
 ", ",
 StyleBox["DisegnaImpiccato[]", "Code"],
 ", e ",
 StyleBox["AggiornaStato[]", "Code"],
 " supportano l\[CloseCurlyQuote]interazione dinamica durante la partita, \
mentre altre come ",
 StyleBox["RigheTastiera", "Code"],
 " gestiscono componenti specifici dell\[CloseCurlyQuote]interfaccia. \n\nLe \
funzioni ",
 StyleBox["HaCaratteriNonAmmessiQ[]", "Code"],
 " e",
 StyleBox[" InizializzaStato[]", "Code"],
 " sono delegate alla gestione della validit\[AGrave] dei caratteri e dell\
\[CloseCurlyQuote]inizializzazione dello stato del gioco. \n\nInfine, ",
 StyleBox["RecuperaClassifica[]", "Code"],
 " e ",
 StyleBox["SalvaRecord[]", "Code"],
 " gestiscono rispettivamente il caricamento e il salvataggio delle \
statistiche utente. "
}], "Text",
 CellChangeTimes->{
  3.9564746564504557`*^9, {3.9564748085337152`*^9, 3.956474808788192*^9}, {
   3.9564748619521513`*^9, 3.956474866928113*^9}, {3.9564749450647182`*^9, 
   3.9564749634402847`*^9}},ExpressionUUID->"8ff5a018-7120-4846-94cf-\
ebadcc645788"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VI Approfondimento 2: un\[CloseCurlyQuote]analogia con il modello dell\
\[CloseCurlyQuote]urna?", "Section",
 CellChangeTimes->{{3.9529516736817017`*^9, 3.952951679762285*^9}, {
   3.9538210639475155`*^9, 3.953821085919277*^9}, {3.953888505964283*^9, 
   3.9538885066750183`*^9}, 3.9538898114668465`*^9, {3.956472198011972*^9, 
   3.956472202238887*^9}, 3.956474316911772*^9, {3.956474486758794*^9, 
   3.9564744870145473`*^9}},ExpressionUUID->"139cd4af-51d0-8949-86b2-\
d9dfe22c3d15"],

Cell[CellGroupData[{

Cell["VI.1 Il modello dell\[CloseCurlyQuote]urna", "Subsection",
 CellChangeTimes->{{3.956472241899461*^9, 3.9564722485458927`*^9}, 
   3.956474322344531*^9},ExpressionUUID->"1129e0ee-fe5a-4044-9515-\
ee507f7cba87"],

Cell[TextData[{
 "Il ",
 StyleBox["modello dell\[CloseCurlyQuote]urna",
  FontWeight->"Bold"],
 " (per approfondimento vedi ",
 ButtonBox["BIBLIO [4]",
  BaseStyle->"Hyperlink",
  ButtonData->"ref4"],
 ") \[EGrave] usato in probabilit\[AGrave] per rappresentare eventi casuali, \
come l\[CloseCurlyQuote]estrazione di palline da un contenitore. In questo \
modello, le palline hanno caratteristiche distinte (ad esempio, colore o \
etichetta) e possono essere estratte ",
 StyleBox["con o senza reimmissione",
  FontWeight->"Bold"],
 ". Nel caso del gioco dell\[CloseCurlyQuote]impiccato, possiamo adattare il \
modello dell\[CloseCurlyQuote]urna per descrivere il processo con cui il \
guesser prova a indovinare le lettere di una parola nascosta.\n\nSe \
indichiamo con ",
 StyleBox["t",
  FontSlant->"Italic"],
 " il numero di lettere distinte presenti nella parola da indovinare, e con \
",
 StyleBox["n",
  FontSlant->"Italic"],
 " il numero totale di lettere dell\[CloseCurlyQuote]alfabeto, possiamo \
immaginare un\[CloseCurlyQuote]urna contenente ",
 StyleBox["t",
  FontSlant->"Italic"],
 " palline bianche, che rappresentano le lettere corrette da indovinare, e ",
 StyleBox["n \[Dash] t",
  FontSlant->"Italic"],
 " palline nere, che rappresentano le lettere sbagliate (",
 StyleBox["errori",
  FontSlant->"Italic"],
 ").\n\nEstraendo palline ",
 StyleBox["senza reimmissione",
  FontWeight->"Bold"],
 ":"
}], "Text",
 CellChangeTimes->{
  3.956472254287814*^9, {3.9564723009127407`*^9, 3.95647230938724*^9}, {
   3.956472373317012*^9, 3.956472380564192*^9}, {3.956472411191465*^9, 
   3.956472412965168*^9}, {3.9564737393457537`*^9, 
   3.95647373934622*^9}},ExpressionUUID->"a681486e-c9a9-4692-9542-\
c940b3150ea8"],

Cell["\tSe escono tutte le bianche prima di d nere \[RightArrow] vittoria.", \
"Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472312329277*^9, 3.95647232269098*^9}, 
   3.956472463212373*^9},ExpressionUUID->"44077c2c-735b-4df4-bde2-\
1f0d28a5f7bf"],

Cell[TextData[{
 "\tSe si estraggono d nere prima delle bianche \[RightArrow] sconfitta.\n\n\
Nel modello dell\[CloseCurlyQuote]urna, la probabilit\[AGrave] di estrarre un \
elemento con una certa caratteristica dopo una o pi\[UGrave] estrazioni \
precedenti dipende da quali elementi sono gi\[AGrave] stati estratti \
precedentemente. In questo contesto, parliamo di probabilit\[AGrave] \
condizionata, indicata con la notazione ",
 StyleBox["P(A\[Divides]B)",
  FontSlant->"Italic"],
 ". Nel gioco Hangman, ci\[OGrave] significa che la probabilit\[AGrave] di \
indovinare una lettera varia a ogni turno, in base alle lettere gi\[AGrave] \
state proposte. \n\n",
 ButtonBox["[1] BIBLIO",
  BaseStyle->"Hyperlink",
  ButtonData->"ref1"]
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9564723169618464`*^9, 3.956472342674267*^9}, 
   3.956472464578816*^9, {3.956473749790237*^9, 
   3.956473749790695*^9}},ExpressionUUID->"94bf6dd9-88c1-4d82-a84d-\
ff76b8eb11f9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["VI.2 Limiti e contraddizioni", "Subsection",
 CellChangeTimes->{{3.9564725041942673`*^9, 3.956472509460725*^9}, 
   3.956474326886138*^9},ExpressionUUID->"12f4d947-53ae-4448-8244-\
ad2078c204fd"],

Cell[TextData[{
 "In realt\[AGrave], il modello dell\[CloseCurlyQuote]urna non si adatta cos\
\[IGrave] facilmente a Hangman perch\[EAcute] assume ",
 StyleBox["estrazioni casuali",
  FontWeight->"Bold"],
 ", nonostante i giocatori usino strategie come:"
}], "Text",
 CellChangeTimes->{{3.95647251281516*^9, 
  3.956472549601438*^9}},ExpressionUUID->"42bbca25-0ada-4e5f-89d5-\
402094c8d33f"],

Cell["\<\
\tConoscere la frequenza delle lettere (in una parola italiana, ad esempio, \
le vocali sono pi\[UGrave] probabili delle consonanti)\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472551895694*^9, 3.956472554909268*^9}, 
   3.956472600000968*^9, 
   3.956472634036929*^9},ExpressionUUID->"46ca9c0d-16bf-44f6-bdcc-\
52f4b773941b"],

Cell["\<\
\tConoscere le combinazioni pi\[UGrave] frequenti (in italiano, ad esempio: \
\[OpenCurlyDoubleQuote]q\[CloseCurlyDoubleQuote] + \[OpenCurlyDoubleQuote]u\
\[CloseCurlyDoubleQuote])\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472556500814*^9, 3.9564725590187693`*^9}, 
   3.956472603165269*^9, 
   3.956472635159988*^9},ExpressionUUID->"417a9924-35ba-4573-896a-\
ad5a4066576f"],

Cell[TextData[{
 "\tConoscenza morfologica: i guesser riconoscono prefissi e suffissi delle \
parole (",
 StyleBox["esempio:",
  FontSlant->"Italic"],
 " \[OpenCurlyDoubleQuote]-zione\[CloseCurlyDoubleQuote] come in \
\[OpenCurlyDoubleQuote]organizzazione\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]traduzione\[CloseCurlyDoubleQuote]; \
\[OpenCurlyDoubleQuote]-mente\[CloseCurlyDoubleQuote] come in \
\[OpenCurlyDoubleQuote]semplicemente\[CloseCurlyDoubleQuote], \
\[OpenCurlyDoubleQuote]dolcemente\[CloseCurlyDoubleQuote])\n\nIl modello dell\
\[CloseCurlyQuote]urna \[EGrave] interessante e utile per analisi teoriche, \
ma non rappresenta fedelmente l\[CloseCurlyQuote]esperienza reale del gioco, \
dove:"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472560175007*^9, 3.95647256827486*^9}, 
   3.956472605970871*^9, 3.956472636150941*^9, {3.956472669450733*^9, 
   3.956472671416956*^9}},ExpressionUUID->"ca09196a-ceb2-4c9f-a851-\
64ddab1a200d"],

Cell["\tcontano intuizione, strategia, e conoscenza linguistica", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472570585559*^9, 3.9564725727149487`*^9}, {
  3.956472608400581*^9, 
  3.956472637682013*^9}},ExpressionUUID->"3596089d-0f40-47ed-88b1-\
c97bc5943ce6"],

Cell["\tle parole usate sono spesso comuni", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472573841593*^9, 3.956472576390258*^9}, {
  3.956472612015579*^9, 
  3.956472638655198*^9}},ExpressionUUID->"5a9fb1a7-6686-4d3f-b451-\
af7cbb6a54bd"],

Cell["\<\
\ti guesser sono pi\[UGrave] intelligenti di un pescatore casuale di lettere!\
\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{
  3.9564725778164997`*^9, {3.956472613470623*^9, 
   3.956472639421587*^9}},ExpressionUUID->"2329e3ab-5b4b-4c68-ba5e-\
80583cefd7d6"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["VII Commenti e lavoro futuro", "Section",
 CellChangeTimes->{{3.95382333373802*^9, 3.9538233378577366`*^9}, {
   3.953888513309351*^9, 3.9538885134979706`*^9}, 3.9538898165657883`*^9, {
   3.956472738454754*^9, 3.9564727386476583`*^9}, 
   3.9564743302609177`*^9},ExpressionUUID->"3bf05045-1f20-a841-8e3b-\
4f999682df50"],

Cell["\<\
Durante l\[CloseCurlyQuote]implementazione del progetto con Wolfram \
Mathematica, abbiamo incontrato alcune difficolt\[AGrave]:\
\>", "Text",
 CellChangeTimes->{
  3.953823391057993*^9, 3.9554182619935923`*^9, {3.9564727422992687`*^9, 
   3.9564727559122562`*^9}},ExpressionUUID->"4ff146a4-f38d-bf44-9c43-\
eaf0d6de72d1"],

Cell["\<\
\tIl linguaggio di programmazione si \[EGrave] rivelato complesso da \
padroneggiare, poich\[EAcute] presenta caratteristiche innovative e poco \
comuni rispetto ad altri linguaggi.\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.95647275734009*^9, 3.956472761628889*^9}, {
  3.956472993472974*^9, 
  3.956472993880886*^9}},ExpressionUUID->"7642aa18-97fb-4f22-b3b7-\
7f12459de832"],

Cell["\<\
\tLa scarsa chiarezza dei messaggi di errore di compilazione ha reso \
difficile individuare e risolvere i problemi nel codice.\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472762919684*^9, 3.956472766052807*^9}, {
  3.9564729983625603`*^9, 
  3.956472998571876*^9}},ExpressionUUID->"13bdbb74-4787-4034-9a13-\
93040c89bb8c"],

Cell[TextData[{
 "\tLa limitata disponibilit\[AGrave] di materiale di riferimento e la \
documentazione essenziale hanno ulteriormente rallentato il lavoro.\n\n\
Nonostante le difficolt\[AGrave], l\[CloseCurlyQuote]esperienza \[EGrave] \
stata molto formativa, poich\[EAcute] ci ha permesso di sviluppare un \
approccio pi\[UGrave] rigoroso, migliorare le nostre capacit\[AGrave] di \
problem solving e approfondire la conoscenza di un ambiente di programmazione \
avanzato. Nonostante le difficolt\[AGrave] iniziali, \
l\[CloseCurlyQuote]esperienza con Mathematica \[EGrave] stata \
complessivamente positiva e ha arricchito le nostre competenze.\n\nNei lavori \
futuri, intendiamo approfondire ulteriormente le potenzialit\[AGrave] del \
gioco dell\[CloseCurlyQuote]Impiccato, esplorando una sua variante \
particolarmente interessante: ",
 StyleBox["Evil Hangman",
  FontWeight->"Bold"],
 ". A differenza della versione classica, in cui il giocatore \
\[OpenCurlyDoubleQuote]setter\[CloseCurlyDoubleQuote] sceglie una parola \
segreta all\[CloseCurlyQuote]inizio del gioco e risponde alle ipotesi del \
\[OpenCurlyDoubleQuote]guesser\[CloseCurlyDoubleQuote] in modo coerente, nel \
gioco Evil Hangman il setter pu\[OGrave] modificare la parola segreta durante \
lo svolgimento della partita, purch\[EAcute] resti coerente con gli indizi gi\
\[AGrave] rivelati. In altre parole, il setter ha il vantaggio strategico di \
adattare dinamicamente la parola segreta per rendere il compito del guesser \
pi\[UGrave] arduo. Questa variante apre sicuramente interessanti prospettive \
dal punto di vista teorico.\n\nUn\[CloseCurlyQuote]ulteriore evoluzione del \
progetto prevede l\[CloseCurlyQuote]adattamento del gioco a ",
 StyleBox["contesti plurilingue",
  FontWeight->"Bold"],
 ", per favorire l\[CloseCurlyQuote]apprendimento delle lingue straniere. Ad \
esempio, si potrebbero confrontare lingue diverse come \
l\[CloseCurlyQuote]italiano e l\[CloseCurlyQuote]inglese, o l\
\[CloseCurlyQuote]italiano e il francese. Si potrebbe ad esempio giocare con \
parole nella ",
 StyleBox["L2",
  FontSlant->"Italic"],
 " (seconda lingua, come l\[CloseCurlyQuote]inglese per uno studente \
italiano), ma ricevere indizi, definizioni o traduzioni nella ",
 StyleBox["L1",
  FontSlant->"Italic"],
 " (prima lingua, cio\[EGrave] la lingua madre dello studente). Questo \
approccio rende il gioco uno strumento utile per \
l\[CloseCurlyQuote]apprendimento del lessico in modo coinvolgente.  \n\n",
 ButtonBox["[3] BIBLIO",
  BaseStyle->"Hyperlink",
  ButtonData->"ref3"]
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956472767434801*^9, 3.9564727857036324`*^9}, 
   3.9564728328049192`*^9, {3.9564728752106447`*^9, 3.956472875450985*^9}, {
   3.9564730007917957`*^9, 3.956473001002667*^9}, {3.956473721332878*^9, 
   3.956473721333337*^9}},ExpressionUUID->"53952ef3-fc68-4464-add7-\
6bc4b7392b60"],

