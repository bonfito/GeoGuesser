Cell[CellGroupData[{

Cell["Indice", "Section",
 CellChangeTimes->{{3.9529513634491577`*^9, 
  3.9529513894718494`*^9}},ExpressionUUID->"61ab9a5d-fe27-8d49-96df-\
04e596fce78c"],

Cell[TextData[{
 StyleBox["Introduzione\nI. Hangman",
  FontWeight->"Bold"],
 "\n\tI.1 Struttura del gioco\n\tI.2 La nostra versione\n\tI.3 \
Formalizzazione ed esempi\n",
 StyleBox["II Guida all\[CloseCurlyQuote]interfaccia\nIII Avviare il gioco\n\
IV Gioco\nV Approfondimento 1: schema delle dipendenze\nVI Approfondimento 2: \
un\[CloseCurlyQuote]analogia con il modello dell\[CloseCurlyQuote]urna?\n\t",
  FontWeight->"Bold"],
 "VI.1 Modello dell\[CloseCurlyQuote]urna\n\tVI.2 Limiti e contraddizioni",
 StyleBox["\nVII Commenti e lavoro futuro\nVIII Bibliografia e sitografia",
  FontWeight->"Bold"]
}], "Text",
 CellChangeTimes->{{3.9529513634491577`*^9, 3.9529513894718494`*^9}, {
  3.95542104997388*^9, 3.955421065775673*^9}, {3.955421096789975*^9, 
  3.9554211619030848`*^9}, {3.955421193754251*^9, 3.955421238570341*^9}, {
  3.955421396528681*^9, 3.955421524754004*^9}, {3.955421570716421*^9, 
  3.9554215734482603`*^9}, {3.956465339999262*^9, 3.956465422317296*^9}, {
  3.956473798577393*^9, 3.956473820911759*^9}, {3.9564743393219023`*^9, 
  3.956474341364439*^9}, {3.956475024581851*^9, 
  3.9564750383377943`*^9}},ExpressionUUID->"935f0f68-a392-ab45-8fcf-\
45c8654d8de8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Introduzione", "Section",
 CellChangeTimes->{{3.9554213900131493`*^9, 
  3.955421392080737*^9}},ExpressionUUID->"ec8a9363-f186-498f-afb4-\
3aa4f82b9ea8"],

Cell["\<\
 Il gioco dell\[CloseCurlyQuote]Impiccato (Hangman) \[EGrave] un passatempo \
linguistico in cui si deve indovinare una parola misteriosa, una lettera alla \
volta. Oltre a essere divertente, stimola la memoria, il vocabolario e il \
ragionamento logico. Il nostro progetto trasforma il gioco classico in un\
\[CloseCurlyQuote]applicazione digitale integrando funzionalit\[AGrave] \
avanzate come: estrazione automatica di parole dal vocabolario, scelta del \
livello di difficolt\[AGrave], sistemi di punteggio dinamici e strumenti di \
aiuto per i giocatori.\
\>", "Text",
 CellChangeTimes->{{3.953788174453327*^9, 3.9537881752210026`*^9}, {
   3.953791691416809*^9, 3.9537916942322407`*^9}, {3.953791734984436*^9, 
   3.9537917356467323`*^9}, {3.9537917684786777`*^9, 
   3.9537917701847496`*^9}, {3.953791802369644*^9, 3.9537918032980423`*^9}, 
   3.956465437041128*^9},ExpressionUUID->"0a13f48f-4b7d-e040-97b9-\
6d810546a458"]
}, Open  ]],

Cell[CellGroupData[{

Cell["I. Hangman", "Section",
 CellChangeTimes->{{3.953788076369793*^9, 
  3.9537880961328297`*^9}},ExpressionUUID->"64199269-405f-7d42-9f26-\
0cec28fb2eef"],

Cell[CellGroupData[{

Cell["I.1 Struttura del gioco", "Subsection",
 CellChangeTimes->{{3.9537881134632626`*^9, 
  3.9537881225617657`*^9}},ExpressionUUID->"b23819c7-b61d-a64c-bdb9-\
5183691a0432"],

Cell["\<\
Il nostro progetto implementa una specifica variante del gioco che prevede \
due ruoli principali:\
\>", "Text",
 CellChangeTimes->{
  3.952951607914589*^9, {3.953009166725668*^9, 3.9530091816463223`*^9}, {
   3.956465487464472*^9, 3.9564655070972548`*^9}, {3.956465583598403*^9, 
   3.9564655928374567`*^9}, {3.956465666682192*^9, 3.956465670610001*^9}, {
   3.956465865129134*^9, 
   3.95646588355002*^9}},ExpressionUUID->"49bc2f04-ebee-1a41-b72f-\
d5d90c3c3bcc"],

Cell[TextData[{
 StyleBox["Setter",
  FontWeight->"Bold"],
 ": sceglie (nel nostro caso, genera) la parola segreta."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.95646589040569*^9, 3.956465897244836*^9}, {
  3.956465992944992*^9, 
  3.956465993305244*^9}},ExpressionUUID->"ea736a33-d451-41d1-9e91-\
7ed29c13defd"],

Cell[TextData[{
 StyleBox["Guesser",
  FontWeight->"Bold"],
 ": indovina la parola proponendo lettere."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9564659002005243`*^9, 3.956465909065289*^9}, {
  3.9564659953441353`*^9, 
  3.956465995614704*^9}},ExpressionUUID->"26e3a77e-4704-4a63-8a1c-\
be563b881d9f"],

Cell["I parametri di partenza sono i seguenti:", "Text",
 CellChangeTimes->{{3.956465910970263*^9, 
  3.9564659239597187`*^9}},ExpressionUUID->"c54f518f-1562-47e1-8db0-\
a6f3b2c5d870"],

Cell[TextData[{
 StyleBox["w",
  FontWeight->"Bold"],
 ": parola impostata dal setter che il guesser deve cercare di indovinare."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.95646592589566*^9, 
  3.9564659314908733`*^9}},ExpressionUUID->"6a4b2766-be9c-479f-a12a-\
bc63f8c0eafe"],

Cell[TextData[{
 StyleBox["k",
  FontWeight->"Bold"],
 ": lunghezza della parola da indovinare."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956465933454485*^9, 
  3.956465941014946*^9}},ExpressionUUID->"f69f1717-3f6b-423d-b1ee-\
01b253625d5b"],

Cell[TextData[{
 StyleBox["d",
  FontWeight->"Bold"],
 ": numero massimo di errori consentiti prima di perdere."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956465938735807*^9, 
  3.956465951620174*^9}},ExpressionUUID->"573da5a4-56c8-4f92-b691-\
b6fd86d8edf8"],

Cell[TextData[{
 StyleBox["s\:1d62",
  FontWeight->"Bold"],
 " : lettera proposta dal guesser al turno i."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.95646595310629*^9, 
  3.956465957364709*^9}},ExpressionUUID->"396d8086-0766-4f78-b222-\
feccc126dd32"],

Cell[TextData[{
 StyleBox["i",
  FontWeight->"Bold"],
 ": numero del turno di gioco, che incrementa di 1 ogni volta che il guesser \
propone una nuova lettera.\n\[NonBreakingSpace]\nAd ogni turno, il guesser \
propone una lettera: se la lettera \[EGrave] nella parola, vengono rivelate \
le sue posizioni, altrimenti, si conta un errore.\nVince il guesser se \
completa la parola; vince il setter se il guesser supera il numero di errori \
consentiti."
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{
  3.9564659594657383`*^9},ExpressionUUID->"9be56a94-c1ab-40b6-8cd6-\
268699fae5a2"]
}, Open  ]],

Cell[CellGroupData[{

Cell["I.2 La nostra versione", "Subsection",
 CellChangeTimes->{{3.9530092361977005`*^9, 3.9530092964097843`*^9}, {
  3.953788129658739*^9, 
  3.9537881340211773`*^9}},ExpressionUUID->"e1eec17d-b810-b441-8ded-\
980b484e5ff3"],

Cell[TextData[{
 "La ",
 StyleBox["parola da indovinare",
  FontWeight->"Bold"],
 " viene estratta automaticamente da un dizionario interno.\nIl ",
 StyleBox["numero di tentativi",
  FontWeight->"Bold"],
 " \[EGrave] sempre pari a 6, indipendentemente dal livello di difficolt\
\[AGrave]."
}], "Text",
 CellChangeTimes->{{3.9530092876732864`*^9, 3.953009368013008*^9}, {
   3.95300945450502*^9, 3.953009483966524*^9}, {3.953010046584263*^9, 
   3.953010047826067*^9}, 3.9530101850484467`*^9, 3.9530102805519676`*^9, {
   3.953788033813444*^9, 3.9537880402791195`*^9}, {3.9537881931069736`*^9, 
   3.9537882772356644`*^9}, {3.9537883164038315`*^9, 3.953788357231451*^9}, {
   3.953788390133322*^9, 3.953788390544256*^9}, {3.953791728842039*^9, 
   3.9537917297404175`*^9}, {3.953881272556818*^9, 3.953881279767956*^9}, {
   3.9538813559805107`*^9, 3.953881405036644*^9}, {3.95388143612397*^9, 
   3.9538814727068253`*^9}, {3.9538893722918224`*^9, 
   3.9538894646574326`*^9}, {3.953889512542488*^9, 3.9538895139729843`*^9}, {
   3.9538897445341816`*^9, 3.9538897550023193`*^9}, 3.956466097372264*^9, {
   3.9564662437789097`*^9, 3.956466265467279*^9}, {3.956466370980444*^9, 
   3.956466373976685*^9}, {3.95646648911882*^9, 
   3.956466493722134*^9}},ExpressionUUID->"765ba2fc-2b1a-d342-9b3a-\
6162fc08e7f6"],

Cell[CellGroupData[{

Cell["Livelli di difficolt\[AGrave] previsti:", "Subsubsection",
 CellChangeTimes->{{3.9564664424405622`*^9, 
  3.956466461652397*^9}},ExpressionUUID->"388d42d3-b0d4-4a10-8af2-\
390c9323f0ee"],

Cell[TextData[{
 "\t",
 StyleBox["Facile",
  FontWeight->"Bold"],
 ": parole da 1 a 5 lettere\t"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9564664663488092`*^9, 3.956466472032383*^9}, {
   3.9564666268532457`*^9, 3.956466631798689*^9}, 
   3.956466714029174*^9},ExpressionUUID->"c93600a3-3455-4050-8859-\
ca18c3645693"],

Cell[TextData[{
 "\t",
 StyleBox["Medio",
  FontWeight->"Bold"],
 ": parole da 6 a 8 lettere"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956466634213572*^9, 3.956466639344507*^9}, 
   3.956466715724345*^9},ExpressionUUID->"31e2f90a-5b69-4115-ad61-\
fdbbe647d866"],

Cell[TextData[{
 "\t",
 StyleBox["Difficile",
  FontWeight->"Bold"],
 ": parole da 9 a 12 lettere"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9564666410534143`*^9, 3.956466643827799*^9}, 
   3.956466716459015*^9},ExpressionUUID->"04e7aa78-8f42-473e-9a2d-\
20eeff05cadc"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Punteggio dinamico:", "Subsubsection",
 CellChangeTimes->{{3.956466507359837*^9, 
  3.956466515607127*^9}},ExpressionUUID->"e2736e09-3b6a-4236-8c2b-\
8b387b4bd68a"],

Cell[TextData[{
 StyleBox["\tLettera indovinata",
  FontWeight->"Bold"],
 " \[RightArrow] +10 \[Times] livello"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{
  3.956466519073662*^9, {3.956466649679636*^9, 3.956466663418624*^9}, 
   3.956466730528884*^9},ExpressionUUID->"23022fb3-0d36-4f4a-9cd1-\
211968732262"],

Cell[TextData[{
 StyleBox["\tSuggerimento",
  FontWeight->"Bold"],
 " \[RightArrow] \[Dash]5 \[Times] livello"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956466665386731*^9, 3.9564666804888887`*^9}, 
   3.956466731893588*^9},ExpressionUUID->"87b2c13f-9320-4b2c-9eab-\
cd6231c0211d"],

Cell["\<\
dove livello rappresenta il livello di difficolt\[AGrave] e a cui viene \
assegnato il seguente valore:

\t\[Bullet]\tfacile = 1
\t\[Bullet]\tmedio = 2
\t\[Bullet]\tdifficile = 3\
\>", "Text",
 CellChangeTimes->{{3.956466682079576*^9, 3.956466685349004*^9}, {
  3.956466765838921*^9, 
  3.956466780643737*^9}},ExpressionUUID->"5b2879fe-3181-4448-b31a-\
feacfb08695c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Strumenti di aiuto:", "Subsubsection",
 CellChangeTimes->{{3.956470223181485*^9, 
  3.9564702307184877`*^9}},ExpressionUUID->"f7c092d1-1f7d-4632-866e-\
917f5bb9950e"],

Cell[TextData[{
 StyleBox["\tPulizia parola",
  FontWeight->"Bold"],
 ": cancella tutte le lettere inserite in precedenza e azzera il punteggio \
del giocatore"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956470232669424*^9, 3.956470245494594*^9}, 
   3.9564702910797997`*^9},ExpressionUUID->"67debb5a-be40-42dc-83f1-\
b421cfa4f50c"],

Cell[TextData[{
 StyleBox["\tSuggerimento",
  FontWeight->"Bold"],
 ": svela una lettera a costo di penalit\[AGrave] di punti"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956470247624405*^9, 
  3.956470292446197*^9}},ExpressionUUID->"173ab07a-dce7-46ef-adcf-\
c6d82e7880ac"],

Cell[TextData[{
 StyleBox["\tSoluzione",
  FontWeight->"Bold"],
 ": rivela la soluzione conducendo alla fine della partita"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956470266240757*^9, 
  3.956470293360547*^9}},ExpressionUUID->"fcc04405-db72-45d9-b25c-\
4a111a497ebf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["I.3 Formalizzazione ed esempi", "Subsection",
 CellChangeTimes->{{3.9530097442575016`*^9, 3.9530097455346203`*^9}, {
  3.953788145180237*^9, 
  3.9537881518260345`*^9}},ExpressionUUID->"db5720e7-0bc5-b94b-9f0e-\
bb417c275c40"],

Cell[TextData[{
 "Dati i parametri di partenza ",
 StyleBox["w",
  FontSlant->"Italic"],
 ", ",
 StyleBox["k",
  FontSlant->"Italic"],
 ", ",
 StyleBox["d",
  FontSlant->"Italic"],
 ",  ",
 StyleBox["s\:1d62",
  FontSlant->"Italic"],
 StyleBox[" ",
  FontWeight->"Bold"],
 "e  ",
 StyleBox["i",
  FontSlant->"Italic"],
 ", il gioco usa tutte le lettere dell\[CloseCurlyQuote]alfabeto. ",
 "\n\nAll\[CloseCurlyQuote]inizio della partita, la parola segreta ",
 StyleBox["w",
  FontSlant->"Italic"],
 " pu\[OGrave] essere una qualsiasi combinazione di ",
 StyleBox["k",
  FontSlant->"Italic"],
 " lettere dell\[CloseCurlyQuote]alfabeto della lingua di riferimento. Man \
mano che il gioco procede, l\[CloseCurlyQuote]alfabeto si riduce: ogni \
lettera gi\[AGrave] provata non pu\[OGrave] essere ripetuta.\nLo stato del \
gioco si rappresenta con una \[OpenCurlyDoubleQuote]",
 StyleBox["maschera",
  FontWeight->"Bold"],
 "\[CloseCurlyDoubleQuote] (nel nostro contesto, la maschera \[EGrave] la \
rappresentazione visiva di ci\[OGrave] che il giocatore ha gi\[AGrave] \
scoperto della parola segreta e di ci\[OGrave] che rimane ancora nascosto) di \
lunghezza ",
 StyleBox["k",
  FontSlant->"Italic"],
 ":"
}], "Text",
 CellChangeTimes->{{3.9530097777340374`*^9, 3.9530097844442425`*^9}, {
   3.9530098247024937`*^9, 3.95300997272151*^9}, {3.953010009872078*^9, 
   3.9530100162650204`*^9}, {3.9530100594968376`*^9, 
   3.9530100614302597`*^9}, {3.953010091447094*^9, 3.953010115210188*^9}, {
   3.953791543288374*^9, 3.9537915439666767`*^9}, 3.955530710645197*^9, {
   3.955536955833736*^9, 3.955536955834154*^9}, 3.956470331500572*^9, 
   3.956470391849999*^9, {3.956470444726873*^9, 3.956470446695039*^9}, {
   3.956470505317342*^9, 3.956470518396872*^9}, {3.956470959989711*^9, 
   3.9564710346958714`*^9}},ExpressionUUID->"1975e73d-73c4-414a-a809-\
7c7940ebbd84"],

Cell["\<\
Per ogni lettera non ancora indovinata si usa un carattere di riempimento \
(nel nostro esempio \[OpenCurlyDoubleQuote]_\[CloseCurlyDoubleQuote]).\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.95647044905094*^9, 
  3.9564704784957647`*^9}},ExpressionUUID->"7632c8ec-dd29-4dd3-bb81-\
4b18c5f486bf"],

Cell[TextData[{
 "Quando il giocatore indovina una lettera, tutte le sue occorrenze vengono \
sostituite al simbolo di riempimento nelle posizioni corrette.\n\nAd ogni \
turno ",
 StyleBox["i",
  FontSlant->"Italic"],
 " (dove i = 1, 2, \[Ellipsis], n), il guesser propone una lettera ",
 StyleBox["s\:1d62",
  FontSlant->"Italic"],
 ".\n\nSuccessivamente il gioco aggiorna la maschera:"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9564704660477*^9, 3.956470481000012*^9}, {
  3.956470571798749*^9, 3.956470639658436*^9}, {3.95647067111583*^9, 
  3.956470676274396*^9}, {3.956470740970852*^9, 
  3.956470749671235*^9}},ExpressionUUID->"8024bafe-2354-4a49-85e9-\
932d8b92fa4a"],

Cell["Se s\:1d62 \[EGrave] presente in w, tutte le sue occorrenze diventano s\
\:1d62.", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956470678119273*^9, 
  3.9564707248292828`*^9}},ExpressionUUID->"8237b0e2-4104-4317-96df-\
1268baf59e63"],

Cell["\<\
Altrimenti, il numero di errori aumenta di 1 e la maschera resta uguale.\
\>", "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956470689280514*^9, 3.956470726884576*^9}, {
  3.956470757711173*^9, 
  3.956470758536109*^9}},ExpressionUUID->"260d1ba9-34ab-4e9a-88f4-\
74812dd38898"],

Cell[CellGroupData[{

Cell["Esempio pratico", "Subsubsection",
 CellChangeTimes->{{3.956470765785334*^9, 
  3.9564707718260736`*^9}},ExpressionUUID->"13d9e177-d85c-46c8-b108-\
fae09860cd32"],

Cell["Supponiamo:", "Text",
 CellChangeTimes->{{3.956470774120656*^9, 
  3.95647080724402*^9}},ExpressionUUID->"858e6f4c-53f6-4717-913f-\
8b6bb00b545f"],

Cell[TextData[{
 StyleBox["w",
  FontSlant->"Italic"],
 " = \[OpenCurlyDoubleQuote]ciao\[CloseCurlyDoubleQuote]"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.9564708103315372`*^9, 
  3.9564708192570667`*^9}},ExpressionUUID->"59acebe0-45fb-4edd-8eef-\
a38c83c5bda2"],

Cell[TextData[{
 StyleBox["k",
  FontSlant->"Italic"],
 " = 4"
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956470821236434*^9, 
  3.956470832201065*^9}},ExpressionUUID->"3a19592e-2ed6-4a17-900d-\
ccf21304521b"],

Cell[TextData[{
 StyleBox["d",
  FontSlant->"Italic"],
 " = 3.\n\nUna possibile partita potrebbe svolgersi nel seguente modo:\n\n",
 Cell[BoxData[
  TagBox[GridBox[{
     {
      StyleBox["i",
       FontWeight->"Bold",
       FontSlant->"Italic"], 
      StyleBox["w",
       FontWeight->"Bold",
       FontSlant->"Italic"], 
      StyleBox["s\:1d62",
       FontWeight->"Bold",
       FontSlant->"Italic"], 
      StyleBox["maschera",
       FontWeight->"Bold",
       FontSlant->"Italic"]},
     {"0", "ciao", "/", 
      RowBox[{"___", "_"}]},
     {"1", "ciao", "e", 
      RowBox[{"___", "_"}]},
     {"2", "ciao", "o", "___o"},
     {"3", "ciao", "a", "__ao"},
     {"4", "ciao", "c", "c_ao"},
     {"5", "ciao", "i", "ciao"}
    },
    GridBoxDividers->{"Columns" -> {{True}}, "Rows" -> {{True}}}],
   "Grid"]],ExpressionUUID->"2b40ac3c-b824-41fd-b55e-26b6d6a6199f"],
 "\n\nIl guesser vince perch\[EAcute] completa \[OpenCurlyDoubleQuote]ciao\
\[CloseCurlyDoubleQuote] prima di arrivare a 3 errori.\n\n",
 ButtonBox["[2]  BIBLIO",
  BaseStyle->"Hyperlink",
  ButtonData->"ref2"]
}], "Text",
 CellDingbat->"\[FilledSquare]",
 CellChangeTimes->{{3.956470828121876*^9, 3.9564708336852093`*^9}, {
  3.956470873242593*^9, 3.956470909364295*^9}, {3.9564711568548117`*^9, 
  3.956471157137939*^9}, {3.9564711906896048`*^9, 3.956471199531687*^9}, {
  3.9564712352141*^9, 3.956471549844494*^9}, {3.956474273487808*^9, 
  3.9564742814132566`*^9}},ExpressionUUID->"0e90de4b-da9f-437e-9998-\
6518fd75afbe"]
}, Open  ]]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["II Guida all\[CloseCurlyQuote]interfaccia", "Section",
