Cell[CellGroupData[{

Cell[BoxData[""], "Input",
 CellChangeTimes->{{3.9872337425227165`*^9, 
  3.987233742539549*^9}},ExpressionUUID->"ed00b04a-debd-2648-908b-\
46aee3225759"],

Cell[BoxData[
 DynamicModuleBox[{HangmanGame`Private`seed$$ = 5, 
  HangmanGame`Private`seedError$$ = "", HangmanGame`Private`fase$$ = "gioco", 
  HangmanGame`Private`gamemode$$ = 1, HangmanGame`Private`parola$$ = {
  "b", "e", "n", "i", "n"}, HangmanGame`Private`stato$$ = {
  "b", "e", "n", "i", "n"}, HangmanGame`Private`errori$$ = {"r", "t"}, 
  HangmanGame`Private`score$$ = -5, HangmanGame`Private`messaggio$$ = 
  "Lettera sbagliata!", HangmanGame`Private`maxErrori$$ = 6, 
  HangmanGame`Private`opzioniBonus$$ = {
  "porto-novo", "san marino", "san salvador", "atene"}, 
  HangmanGame`Private`faseBonusCompletata$$ = True, 
  HangmanGame`Private`messaggioBonus$$ = 
  "Sbagliato! La risposta corretta era: Porto-novo"}, 
  DynamicBox[ToBoxes[
    Switch[HangmanGame`Private`fase$$, "selezione", 
     Column[{
       Style["Seleziona la difficolt\[AGrave]", Bold, 20], 
       RadioButtonBar[
        Dynamic[HangmanGame`Private`gamemode$$], {
        1 -> "Facile", 2 -> "Media", 3 -> "Difficile"}], 
       Row[{"Seed (opzionale): ", 
         InputField[
          Dynamic[
          HangmanGame`Private`seed$$, ({
            HangmanGame`Private`seed$$, HangmanGame`Private`seedError$$} = If[
             Or[
              StringMatchQ[#, 
               Repeated[DigitCharacter]], 
              StringMatchQ[#, ""]], {#, ""}, {
             HangmanGame`Private`seed$$, 
              "Inserire solo numeri naturali (0, 1, 2, ...)."}])& ], String, 
          FieldHint -> "Inserire un numero naturale", ContinuousAction -> 
          True]}], 
       Dynamic[
        If[HangmanGame`Private`seedError$$ != "", 
         Style[HangmanGame`Private`seedError$$, Red, Italic], ""]], 
       Button["Inizia partita", 
        Module[{}, If[
           And[
            StringQ[HangmanGame`Private`seed$$], HangmanGame`Private`seed$$ != 
            ""], HangmanGame`Private`seed$$ = 
           ToExpression[HangmanGame`Private`seed$$], 
           HangmanGame`Private`seed$$ = Automatic]; {
           HangmanGame`Private`parola$$, HangmanGame`Private`stato$$, 
            HangmanGame`Private`errori$$, HangmanGame`Private`score$$} = 
          HangmanGame`Private`GeneraEsericizio[
           HangmanGame`Private`gamemode$$, HangmanGame`Private`seed$$]; 
         HangmanGame`Private`fase$$ = "gioco"; 
         HangmanGame`Private`messaggio$$ = ""; 
         HangmanGame`Private`opzioniBonus$$ = {}; 
         HangmanGame`Private`faseBonusCompletata$$ = False; 
         HangmanGame`Private`messaggioBonus$$ = ""; Null], 
        ImageSize -> {150, 60}, BaseStyle -> {FontSize -> 16, Bold, White}, 
        Background -> RGBColor[0.1, 0.4, 0.9]]}, Spacings -> 2], "gioco", 
     Column[{
       Style["Gioco dell'impiccato", Bold, 28], 
       Spacer[10], 
       Dynamic[
        Row[{"Punteggio: ", 
          Style[HangmanGame`Private`score$$, 
           RGBColor[0.1, 0.4, 0.9], Bold, 20]}]], 
       Spacer[10], 
       Dynamic[
        Row[
         Riffle[
          Map[If[# === "_", 
            Style[" _ ", Gray, Bold, 28], 
            Style[#, Bold, 28]]& , HangmanGame`Private`stato$$], " "]]], 
       Spacer[10], 
       Row[{
         Button[
         "Suggerimento", {
           HangmanGame`Private`stato$$, HangmanGame`Private`errori$$, 
            HangmanGame`Private`score$$} = 
          HangmanGame`Private`Suggerimento[
           HangmanGame`Private`parola$$, HangmanGame`Private`stato$$, 
            HangmanGame`Private`errori$$, HangmanGame`Private`score$$, 
            HangmanGame`Private`gamemode$$], Enabled -> And[
            MemberQ[HangmanGame`Private`stato$$, "_"], 
            Length[HangmanGame`Private`errori$$] < 
            HangmanGame`Private`maxErrori$$], 
          BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
          RGBColor[0.8, 0.5, 0.], ImageSize -> {140, 38}], 
         Spacer[20], 
         Button[
         "Mostra soluzione", 
          HangmanGame`Private`MostraSoluzione[
           HangmanGame`Private`parola$$]; {
            HangmanGame`Private`stato$$, HangmanGame`Private`fase$$, 
             HangmanGame`Private`messaggio$$, 
             HangmanGame`Private`seedError$$} = {
            HangmanGame`Private`parola$$, "selezione", "", ""}, 
          BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
          RGBColor[0.4, 0.1, 0.6], ImageSize -> {160, 38}]}], 
       Dynamic[
        Row[{"Lettere sbagliate: ", 
          Style[
           StringJoin[
            Riffle[HangmanGame`Private`errori$$, ", "]], Red, Bold]}]], 
       Dynamic[
        Row[{"Errori: ", 
          Style[
           Length[HangmanGame`Private`errori$$], Red, Bold], "/", 
          HangmanGame`Private`maxErrori$$}]], 
       Dynamic[
        Style[HangmanGame`Private`messaggio$$, 
         RGBColor[0.1, 0.4, 0.9], Bold]], 
       Dynamic[
        HangmanGame`Private`DisegnaImpiccato[
         Length[HangmanGame`Private`errori$$]]], 
       Spacer[10], 
       Dynamic[
        Column[
         Map[Row[
           Join[{
             Spacer[Part[#, 1] 25]}, 
            Table[
             With[{HangmanGame`Private`l$ = HangmanGame`Private`lettera}, 
              Button[
               Style[HangmanGame`Private`l$, White, Bold, FontSize -> 16], 
               Module[{HangmanGame`Private`guess$ = ToLowerCase[
                   StringTrim[HangmanGame`Private`l$]]}, {
                  HangmanGame`Private`stato$$, HangmanGame`Private`errori$$, 
                   HangmanGame`Private`score$$} = 
                 HangmanGame`Private`AggiornaStato[
                  HangmanGame`Private`parola$$, HangmanGame`Private`stato$$, 
                   HangmanGame`Private`guess$, HangmanGame`Private`score$$, 
                   HangmanGame`Private`gamemode$$, 
                   HangmanGame`Private`errori$$]; 
                HangmanGame`Private`messaggio$$ = If[
                   MemberQ[
                   HangmanGame`Private`parola$$, HangmanGame`Private`guess$], 
                   "Lettera corretta!", "Lettera sbagliata!"]; Null], Enabled -> 
               And[
                 Not[
                  MemberQ[
                   Join[
                   HangmanGame`Private`stato$$, HangmanGame`Private`errori$$], 
                   ToLowerCase[HangmanGame`Private`l$]]], 
                 MemberQ[HangmanGame`Private`stato$$, "_"], 
                 Length[HangmanGame`Private`errori$$] < 
                 HangmanGame`Private`maxErrori$$], Background -> Which[
                 MemberQ[HangmanGame`Private`stato$$, 
                  ToLowerCase[HangmanGame`Private`l$]], 
                 RGBColor[0.2, 0.7, 0.3], 
                 MemberQ[HangmanGame`Private`errori$$, 
                  ToLowerCase[HangmanGame`Private`l$]], 
                 RGBColor[0.75, 0.15, 0.15], True, 
                 RGBColor[0.15, 0.35, 0.75]], ImageSize -> {48, 48}]], {
             HangmanGame`Private`lettera, 
              Part[#, 2]}]], 
           Spacer[4]]& , HangmanGame`Private`righeTastiera], Spacings -> 
         0.8]], 
       Dynamic[
        If[
         Or[
         HangmanGame`Private`stato$$ === HangmanGame`Private`parola$$, 
          Length[HangmanGame`Private`errori$$] >= 
          HangmanGame`Private`maxErrori$$], 
         Column[{
           If[HangmanGame`Private`stato$$ === HangmanGame`Private`parola$$, 
            If[
             Not[HangmanGame`Private`faseBonusCompletata$$], 
             If[HangmanGame`Private`opzioniBonus$$ === {}, 
               
               Module[{
                HangmanGame`Private`corretta$ = 
                 HangmanGame`Private`dizionarioGeografia[
                   StringJoin[HangmanGame`Private`parola$$]], 
                 HangmanGame`Private`sbagliate$}, 
                HangmanGame`Private`sbagliate$ = RandomSample[
                   DeleteCases[
                    Values[HangmanGame`Private`dizionarioGeografia], 
                    HangmanGame`Private`corretta$], 3]; 
                HangmanGame`Private`opzioniBonus$$ = RandomSample[
                   
                   Join[{HangmanGame`Private`corretta$}, 
                    HangmanGame`Private`sbagliate$]]; Null]]; Column[{
                Spacer[10], 
                Style["Hai vinto!", Green, Bold, 18], 
                Style["Domanda Bonus (+50 punti extra!):", Purple, Bold, 18], 
                Spacer[10], 
                Row[{"Qual \[EGrave] la capitale di ", 
                  Capitalize[
                   StringJoin[HangmanGame`Private`parola$$]], "? "}], 
                Row[
                 Riffle[
                  Map[Button[
                    Capitalize[#], 
                    If[# === HangmanGame`Private`dizionarioGeografia[
                    StringJoin[HangmanGame`Private`parola$$]], 
                    HangmanGame`Private`score$$ = 
                    HangmanGame`Private`score$$ + 50; 
                    HangmanGame`Private`messaggioBonus$$ = 
                    "Risposta corretta! Hai guadagnato 50 punti extra.", 
                    HangmanGame`Private`messaggioBonus$$ = 
                    "Sbagliato! La risposta corretta era: " <> Capitalize[
                    HangmanGame`Private`dizionarioGeografia[
                    StringJoin[HangmanGame`Private`parola$$]]]]; 
                    HangmanGame`Private`faseBonusCompletata$$ = True; Null]& ,
                    HangmanGame`Private`opzioniBonus$$], 
                  Spacer[10]]]}, Alignment -> Center], 
             Column[{
               Spacer[10], 
               Style[HangmanGame`Private`messaggioBonus$$, 
                If[
                 StringContainsQ[
                 HangmanGame`Private`messaggioBonus$$, "punti extra"], Green, 
                 Red], Bold], 
               Spacer[10], 
               Button["Salva e Mostra Classifica", 
                SessionSubmit[
                 HangmanGame`Private`MostraClassificaGUI[
                 HangmanGame`Private`score$$]], 
                BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
                RGBColor[0.1, 0.4, 0.9], ImageSize -> {240, 42}]}, Alignment -> 
              Center]], 
            Column[{
              Spacer[10], 
              Style["Hai perso! La nazione era: " <> Capitalize[
                 StringJoin[HangmanGame`Private`parola$$]], Red, Bold], 
              Spacer[10], 
              Button["Salva e Mostra Classifica", 
               SessionSubmit[
                HangmanGame`Private`MostraClassificaGUI[
                HangmanGame`Private`score$$]], 
               BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
               RGBColor[0.1, 0.4, 0.9], ImageSize -> {240, 42}]}, Alignment -> 
             Center]], 
           Spacer[25], 
           Button[
           "Pulisci Campi", {
              HangmanGame`Private`stato$$, HangmanGame`Private`errori$$, 
               HangmanGame`Private`score$$} = 
             HangmanGame`Private`Pulisci[HangmanGame`Private`parola$$]; 
            HangmanGame`Private`opzioniBonus$$ = {}; 
            HangmanGame`Private`faseBonusCompletata$$ = False; 
            HangmanGame`Private`messaggioBonus$$ = ""; Null, 
            BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
            RGBColor[0.2, 0.5, 0.7], ImageSize -> {150, 38}]}], ""]], 
       Button["Nuova partita", 
        Module[{}, HangmanGame`Private`fase$$ = "selezione"; 
         HangmanGame`Private`messaggio$$ = ""; 
         HangmanGame`Private`seedError$$ = ""; 
         HangmanGame`Private`opzioniBonus$$ = {}; 
         HangmanGame`Private`faseBonusCompletata$$ = False; 
         HangmanGame`Private`messaggioBonus$$ = ""; Null], 
        BaseStyle -> {White, Bold, FontSize -> 13}, Background -> 
        RGBColor[0.3, 0.3, 0.8], ImageSize -> {150, 40}]}]], StandardForm],
   ImageSizeCache->{
    419.53511286163325`, {326.6720067459383, 330.79458966965234`}}],
  DynamicModuleValues:>{}]], "Output",
 CellChangeTimes->{{3.98723320542437*^9, 3.9872332058900204`*^9}, 
   3.9872337279420605`*^9},
 CellLabel->"Out[14]=",ExpressionUUID->"267bf886-cba8-7542-bab0-1fa27abd95e4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Indice", "Section",ExpressionUUID->"6be57565-38d9-ce45-bf2a-803c9f34eb1b"],

Cell["\<\
\[Bullet] INTRODUZIONE
\[Bullet] I. Regole del Gioco
\[Bullet] II. Guida all'Uso dell'Interfaccia
\[Bullet] III. Livello Bonus e Classifica
